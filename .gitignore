# Project specific
/build
/cmake-build-*
/temp
/dist
/node_modules
/scripts/launch/node_modules/

# Let third party libraries handle by themselves
!/third_party/**

#### Begin plugin added ignores

# CMake
CMakeLists.txt.user
CMakeCache.txt
CMakeFiles
CMakeScripts
Testing
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps

# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Local History for Visual Studio Code
.history/

# IDEA
.idea/
.run/

# General
.DS_Store
.AppleDouble
.LSOverride
*:Zone.Identifier

# Icon must end with two \r
Icon


# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

.virtualenv
# Windows helper scripts are SOURCE, not build output. The blanket *.cmd rule
# above belongs to the kernel-module section and was silently swallowing the
# Apollo session hooks and build scripts, so they could never be reproduced
# from the repo.
!xlink/host/*.cmd
!xlink/dispwake/*.cmd
!fork/host/*.cmd
!fork/*.cmd

# Assembled fork bundle payload (binaries; rebuild with fork/assemble.ps1)
fork/dist/

# Pulled TV runtime diagnostic log (an artifact, not source)
aurora-diag.log

# cross-compiled ARM test binary (build per tests/coop/ndl_pipeline_probe.c header)
tests/coop/ndl_pipeline_probe

# large reference capture kept out of git; regenerate with /tmp/coop-dump on the TV
tests/coop/*.h265
__pycache__/

# Claude Code: share the agent roster + project settings, never the machine-local ones.
# settings.local.json holds this rig's IPs, absolute Windows paths and the permission
# allowlist. It was only ever protected by a GLOBAL ignore on this machine, which does
# not travel with a clone -- so pin it here too.
.claude/settings.local.json
.claude/agent-memory-local/

# Visual Studio workspace state (was tracked until 2026-09-19)
.vs/

# co-op audio analysis (2026-10-04..06): recordings, decoded copies and compiled tools stay local
scratchpad/coop-audio-*/*.wav
scratchpad/coop-audio-*/*.raw
scratchpad/coop-audio-*/*.pkl
