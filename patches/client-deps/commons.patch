diff --git a/util/logging/logging_android.c b/util/logging/logging_android.c
new file mode 100644
index 0000000..d700df0
--- /dev/null
+++ b/util/logging/logging_android.c
@@ -0,0 +1,66 @@
+/* Android: the system log (adb logcat -s Eclipse), as PmLog on webOS -- and stderr too, which a kept
+ * diagnostic log captures into its file, as on every other platform. */
+#include "logging.h"
+
+#include <android/log.h>
+#include <stdio.h>
+#include <string.h>
+#include <time.h>
+
+#define LOGCAT_TAG "Eclipse"
+
+static struct timespec ts_init;
+
+void commons_logging_init(const char *context_name) {
+    (void) context_name;
+    clock_gettime(CLOCK_MONOTONIC, &ts_init);
+}
+
+void commons_logging_deinit() {
+    // No-op
+}
+
+void commons_log_vprintf(commons_log_level level, const char *tag, const char *fmt, va_list arg) {
+    int priority;
+    switch (level) {
+        case COMMONS_LOG_LEVEL_FATAL:
+            priority = ANDROID_LOG_FATAL;
+            break;
+        case COMMONS_LOG_LEVEL_ERROR:
+            priority = ANDROID_LOG_ERROR;
+            break;
+        case COMMONS_LOG_LEVEL_WARN:
+            priority = ANDROID_LOG_WARN;
+            break;
+        case COMMONS_LOG_LEVEL_INFO:
+            priority = ANDROID_LOG_INFO;
+            break;
+        case COMMONS_LOG_LEVEL_DEBUG:
+            priority = ANDROID_LOG_DEBUG;
+            break;
+        case COMMONS_LOG_LEVEL_VERBOSE:
+            priority = ANDROID_LOG_VERBOSE;
+            break;
+        default:
+            return;
+    }
+    char msg[1024];
+    vsnprintf(msg, sizeof(msg), fmt, arg);
+    size_t len = strlen(msg);
+    if (len > 0 && msg[len - 1] == '\n') {
+        msg[len - 1] = '\0';
+    }
+    __android_log_print(priority, LOGCAT_TAG, "[%s] %s", tag, msg);
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    ts.tv_sec -= ts_init.tv_sec;
+    ts.tv_nsec -= ts_init.tv_nsec;
+    if (ts.tv_nsec < 0) {
+        ts.tv_sec--;
+        ts.tv_nsec += 1000000000;
+    }
+    static const char letters[] = {'V', 'D', 'I', 'W', 'E', 'F'};
+    const int index = priority - ANDROID_LOG_VERBOSE;
+    fprintf(stderr, "[%ld.%03ld][%s] %c %s\n", (long) ts.tv_sec, ts.tv_nsec / 1000000, tag,
+            index >= 0 && index < (int) sizeof(letters) ? letters[index] : '?', msg);
+}
