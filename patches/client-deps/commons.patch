@@ -0,0 +1,36 @@
+#include "copyfile.h"
+
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static const char *const source_path = "test_copyfile_std_source.bin";
+static const char *const destination_path = "test_copyfile_std_destination.bin";
+
+int main(void) {
+    static const unsigned char expected[] = {
+            0x00, 0x01, 0x02, 0x7f, 0x80, 0xfe, 0xff, 'A', 'u', 'r', 'o', 'r', 'a', '\n',
+    };
+
+    remove(source_path);
+    remove(destination_path);
+
+    FILE *source = fopen(source_path, "wb");
+    assert(source != NULL);
+    assert(fwrite(expected, 1, sizeof(expected), source) == sizeof(expected));
+    assert(fclose(source) == 0);
+
+    assert(copyfile(source_path, destination_path) == 0);
+
+    unsigned char actual[sizeof(expected) + 1] = {0};
+    FILE *destination = fopen(destination_path, "rb");
+    assert(destination != NULL);
+    assert(fread(actual, 1, sizeof(actual), destination) == sizeof(expected));
+    assert(feof(destination));
+    assert(fclose(destination) == 0);
+    assert(memcmp(actual, expected, sizeof(expected)) == 0);
+
+    assert(remove(source_path) == 0);
+    assert(remove(destination_path) == 0);
+    return 0;
+}
