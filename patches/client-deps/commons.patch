diff --git a/device/gcdb-updater/test_gcdb_atomic.c b/device/gcdb-updater/test_gcdb_atomic.c
new file mode 100644
index 0000000..2d09db1
--- /dev/null
+++ b/device/gcdb-updater/test_gcdb_atomic.c
@@ -0,0 +1,46 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "gamecontrollerdb_updater_internal.h"
+
+static const char *const destination_path = "test_gcdb_atomic_destination.txt";
+static const char *const staged_path = "test_gcdb_atomic_staged.txt";
+
+static void write_text(const char *path, const char *text) {
+    FILE *fp = fopen(path, "wb");
+    assert(fp != NULL);
+    assert(fwrite(text, 1, strlen(text), fp) == strlen(text));
+    assert(fclose(fp) == 0);
+}
+
+static void assert_text(const char *path, const char *expected) {
+    char actual[64] = {0};
+    FILE *fp = fopen(path, "rb");
+    assert(fp != NULL);
+    assert(fread(actual, 1, sizeof(actual) - 1, fp) == strlen(expected));
+    assert(feof(fp));
+    assert(fclose(fp) == 0);
+    assert(strcmp(actual, expected) == 0);
+}
+
+int main(void) {
+    remove(destination_path);
+    remove(staged_path);
+
+    write_text(destination_path, "last-good");
+    assert(!commons_gcdb_replace_staged_file(staged_path, destination_path));
+    assert_text(destination_path, "last-good");
+
+    write_text(staged_path, "complete-update");
+    assert(commons_gcdb_replace_staged_file(staged_path, destination_path));
+    assert_text(destination_path, "complete-update");
+
+    assert(commons_gcdb_classify_response(CURLE_PARTIAL_FILE, 200) == COMMONS_GCDB_UPDATER_CURL_ERROR);
+    assert(commons_gcdb_classify_response(CURLE_OK, 200) == COMMONS_GCDB_UPDATER_UPDATED);
+    assert(commons_gcdb_classify_response(CURLE_OK, 304) == COMMONS_GCDB_UPDATER_NO_UPDATE);
+    assert(commons_gcdb_classify_response(CURLE_OK, 404) == COMMONS_GCDB_UPDATER_HTTP_ERROR);
+
+    assert(remove(destination_path) == 0);
+    return 0;
+}
diff --git a/device/gcdb-updater/test_gcdb_deinit.c b/device/gcdb-updater/test_gcdb_deinit.c
new file mode 100644
index 0000000..1babbc5
--- /dev/null
+++ b/device/gcdb-updater/test_gcdb_deinit.c
@@ -0,0 +1,110 @@
+/* An updater deinitialised while its download is in flight, as when the app quits during the start-up update.
+ * Cancelling a task that is already running does not stop it, so the transfer outlives the updater: when the
+ * reply arrives it must not use the updater (deinit has zeroed it), nor what the caller freed after deinit,
+ * nor call back, and it must stop rather than run to the end. A local server sends the reply only after
+ * deinit. Plain checks, never assert(): the calls must run in a release build too. */
+#include <arpa/inet.h>
+#include <errno.h>
+#include <netinet/in.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+#include <SDL.h>
+
+#include "executor.h"
+#include "gamecontrollerdb_updater.h"
+#include "logging.h"
+
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "%s:%d: CHECK failed: %s\n", __FILE__, __LINE__, #x); return 1; } } while (0)
+
+static int listen_fd = -1;
+static SDL_atomic_t callbacks;
+
+static void on_updated(commons_gcdb_status_t result, void *context) {
+    (void) result;
+    (void) context;
+    SDL_AtomicIncRef(&callbacks);
+}
+
+/* Accepts the updater's connection, answers only after the test has deinitialised the updater, then sends the
+ * body slowly: a transfer that is not stopped keeps receiving for several seconds. */
+static int serve(void *arg) {
+    (void) arg;
+    int fd = accept(listen_fd, NULL, NULL);
+    if (fd < 0) {
+        return 1;
+    }
+    SDL_Delay(600);
+    static const char head[] = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nETag: \"deinit-test\"\r\n"
+                               "Content-Length: 4000\r\n\r\n";
+    send(fd, head, sizeof(head) - 1, MSG_NOSIGNAL);
+    static const char line[] = "03000000000000000000000000000000,Pad,a:b0,platform:Linux,\n";   /* 58 bytes */
+    for (int i = 0; i < 68; i++) {
+        if (send(fd, line, sizeof(line) - 1, MSG_NOSIGNAL) < 0) {
+            break;
+        }
+        SDL_Delay(50);
+    }
+    close(fd);
+    return 0;
+}
+
+int main() {
+    commons_logging_init("test");
+    SDL_AtomicSet(&callbacks, 0);
+
+    listen_fd = socket(AF_INET, SOCK_STREAM, 0);
+    CHECK(listen_fd >= 0);
+    struct sockaddr_in addr = {.sin_family = AF_INET, .sin_addr.s_addr = htonl(INADDR_LOOPBACK)};
+    CHECK(bind(listen_fd, (struct sockaddr *) &addr, sizeof(addr)) == 0);
+    CHECK(listen(listen_fd, 1) == 0);
+    socklen_t len = sizeof(addr);
+    CHECK(getsockname(listen_fd, (struct sockaddr *) &addr, &len) == 0);
+    char url[64];
+    snprintf(url, sizeof(url), "http://127.0.0.1:%d/gamecontrollerdb.txt", ntohs(addr.sin_port));
+    SDL_Thread *server = SDL_CreateThread(serve, "gcdb-server", NULL);
+    CHECK(server != NULL);
+
+    static const char name[] = "gcdb_deinit_test.txt";
+    unlink(name);
+    /* Owned by the caller and freed straight after deinit, as the app frees its CA bundle path. */
+    char *path = strdup(name);
+    char *ca_path = strdup("");
+    CHECK(path != NULL && ca_path != NULL);
+
+    executor_t *executor = executor_create("gcdb_deinit", 1);
+    commons_gcdb_updater_t updater = {
+            .platform = "Linux",
+            .path = path,
+            .ca_path = ca_path,
+            .url = url,
+            .callback = on_updated,
+    };
+    commons_gcdb_updater_init(&updater, executor);
+    CHECK(commons_gcdb_updater_update(&updater));
+    SDL_Delay(200);   /* connected, waiting for the reply */
+
+    commons_gcdb_updater_deinit(&updater);
+    memset(path, 'x', sizeof(name) - 1);
+    free(path);
+    free(ca_path);
+
+    /* The reply arrives now. Joining the worker must not wait for the whole body (68 x 50 ms). */
+    Uint32 start = SDL_GetTicks();
+    SDL_Delay(1000);
+    executor_destroy(executor);
+    Uint32 elapsed = SDL_GetTicks() - start;
+
+    CHECK(SDL_AtomicGet(&callbacks) == 0);
+    CHECK(access(name, F_OK) != 0 && errno == ENOENT);
+    CHECK(elapsed < 2500);
+
+    SDL_WaitThread(server, NULL);
+    close(listen_fd);
+    commons_logging_deinit();
+    printf("deinit during a download: no crash, no callback, no file, stopped after %u ms\n", (unsigned) elapsed);
+    return 0;
+}
