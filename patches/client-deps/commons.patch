diff --git a/device/gcdb-updater/test_gcdb_atomic.c b/device/gcdb-updater/test_gcdb_atomic.c
new file mode 100644
index 0000000..2d09db1
--- /dev/null
+++ b/device/gcdb-updater/test_gcdb_atomic.c
@@ -0,0 +1,46 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "gamecontrollerdb_updater_internal.h"
+
+static const char *const destination_path = "test_gcdb_atomic_destination.txt";
+static const char *const staged_path = "test_gcdb_atomic_staged.txt";
+
+static void write_text(const char *path, const char *text) {
+    FILE *fp = fopen(path, "wb");
+    assert(fp != NULL);
+    assert(fwrite(text, 1, strlen(text), fp) == strlen(text));
+    assert(fclose(fp) == 0);
+}
+
+static void assert_text(const char *path, const char *expected) {
+    char actual[64] = {0};
+    FILE *fp = fopen(path, "rb");
+    assert(fp != NULL);
+    assert(fread(actual, 1, sizeof(actual) - 1, fp) == strlen(expected));
+    assert(feof(fp));
+    assert(fclose(fp) == 0);
+    assert(strcmp(actual, expected) == 0);
+}
+
+int main(void) {
+    remove(destination_path);
+    remove(staged_path);
+
+    write_text(destination_path, "last-good");
+    assert(!commons_gcdb_replace_staged_file(staged_path, destination_path));
+    assert_text(destination_path, "last-good");
+
+    write_text(staged_path, "complete-update");
+    assert(commons_gcdb_replace_staged_file(staged_path, destination_path));
+    assert_text(destination_path, "complete-update");
+
+    assert(commons_gcdb_classify_response(CURLE_PARTIAL_FILE, 200) == COMMONS_GCDB_UPDATER_CURL_ERROR);
+    assert(commons_gcdb_classify_response(CURLE_OK, 200) == COMMONS_GCDB_UPDATER_UPDATED);
+    assert(commons_gcdb_classify_response(CURLE_OK, 304) == COMMONS_GCDB_UPDATER_NO_UPDATE);
+    assert(commons_gcdb_classify_response(CURLE_OK, 404) == COMMONS_GCDB_UPDATER_HTTP_ERROR);
+
+    assert(remove(destination_path) == 0);
+    return 0;
+}
