+/* libcurl's progress report, at least once a second during a transfer: a non-zero return stops it. */
+static int transfer_progress(void *clientp, curl_off_t dltotal, curl_off_t dlnow, curl_off_t ultotal,
+                             curl_off_t ulnow) {
+    (void) dltotal;
+    (void) dlnow;
+    (void) ultotal;
+    (void) ulnow;
+    task_context *ctx = clientp;
+    SDL_LockMutex(ctx->link->lock);
+    bool attached = ctx->link->attached;
+    SDL_UnlockMutex(ctx->link->lock);
+    return attached ? 0 : 1;
+}
+
+static void link_release(struct commons_gcdb_link *link) {
+    SDL_LockMutex(link->lock);
+    bool last = --link->refs == 0;
+    SDL_UnlockMutex(link->lock);
+    if (last) {
+        SDL_DestroyMutex(link->lock);
+        free(link);
+    }
+}
