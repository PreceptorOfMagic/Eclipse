+commons_gcdb_status_t commons_gcdb_classify_response(CURLcode code, int status) {
+    if (code != CURLE_OK || status < 0) {
+        return COMMONS_GCDB_UPDATER_CURL_ERROR;
+    }
+    if (status == 200) {
+        return COMMONS_GCDB_UPDATER_UPDATED;
+    }
+    if (status == 304) {
+        return COMMONS_GCDB_UPDATER_NO_UPDATE;
+    }
+    if (status >= 400) {
+        return COMMONS_GCDB_UPDATER_HTTP_ERROR;
+    }
+    return COMMONS_GCDB_UPDATER_NO_UPDATE;
+}
+
+bool commons_gcdb_replace_staged_file(const char *temp_path, const char *destination_path) {
+    if (temp_path == NULL || destination_path == NULL) {
+        return false;
+    }
+#if defined(_WIN32)
+    wchar_t *wide_temp = utf8_to_wide(temp_path);
+    wchar_t *wide_destination = utf8_to_wide(destination_path);
+    bool replaced = wide_temp != NULL && wide_destination != NULL &&
+                    MoveFileExW(wide_temp, wide_destination, MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH) != 0;
+    free(wide_temp);
+    free(wide_destination);
+    return replaced;
+#else
+    return rename(temp_path, destination_path) == 0;
+#endif
+}
+
+static FILE *open_file(const char *path, const char *mode) {
+#if defined(_WIN32)
+    wchar_t *wide_path = utf8_to_wide(path);
+    wchar_t *wide_mode = utf8_to_wide(mode);
+    FILE *fp = NULL;
+    if (wide_path != NULL && wide_mode != NULL) {
+        fp = _wfopen(wide_path, wide_mode);
+    }
+    free(wide_path);
+    free(wide_mode);
+    return fp;
+#else
+    return fopen(path, mode);
+#endif
+}
+
+static bool configure_ca_bundle(CURL *curl, const char *path) {
+    if (path == NULL || path[0] == '\0') {
+        return true;
+    }
+#if LIBCURL_VERSION_NUM >= 0x074700
+    FILE *file = open_file(path, "rb");
+    if (file == NULL || fseek(file, 0, SEEK_END) != 0) {
+        if (file != NULL) {
+            fclose(file);
+        }
+        return false;
+    }
+    const long end = ftell(file);
+    if (end <= 0 || fseek(file, 0, SEEK_SET) != 0) {
+        fclose(file);
+        return false;
+    }
+    unsigned char *data = malloc((size_t) end);
+    if (data == NULL) {
+        fclose(file);
+        return false;
+    }
+    bool read_ok = fread(data, 1, (size_t) end, file) == (size_t) end;
+    if (fclose(file) != 0) {
+        read_ok = false;
+    }
+    if (!read_ok) {
+        free(data);
+        return false;
+    }
+    const struct curl_blob blob = {
+            .data = data,
+            .len = (size_t) end,
+            .flags = CURL_BLOB_COPY,
+    };
+    const CURLcode result = curl_easy_setopt(curl, CURLOPT_CAINFO_BLOB, &blob);
+    free(data);
+    return result == CURLE_OK;
+#else
+    (void) curl;
+    commons_log_warn("GameControllerDB", "libcurl is too old for UTF-8-safe CA bundle loading");
+    return false;
+#endif
+}
+
+static char *make_temp_path(const char *path) {
+#if defined(_WIN32)
+    unsigned long process_id = (unsigned long) _getpid();
+#else
+    unsigned long process_id = (unsigned long) getpid();
+#endif
+    size_t length = strlen(path) + 32;
+    char *temp_path = malloc(length);
+    if (temp_path != NULL) {
+        snprintf(temp_path, length, "%s.download.%lu", path, process_id);
+    }
+    return temp_path;
+}
+
+static void discard_temp_file(task_context *ctx) {
+    if (ctx->temp_path == NULL) {
+        return;
+    }
+#if defined(_WIN32)
+    wchar_t *wide_path = utf8_to_wide(ctx->temp_path);
+    if (wide_path != NULL) {
+        DeleteFileW(wide_path);
+    }
+    free(wide_path);
+#else
+    unlink(ctx->temp_path);
+#endif
+    free(ctx->temp_path);
+    ctx->temp_path = NULL;
+}
+
+#if defined(_WIN32)
+static wchar_t *utf8_to_wide(const char *value) {
+    if (value == NULL) {
+        return NULL;
+    }
+    int length = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, value, -1, NULL, 0);
+    if (length == 0) {
+        return NULL;
+    }
+    wchar_t *wide = malloc((size_t) length * sizeof(wchar_t));
+    if (wide == NULL || MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, value, -1, wide, length) == 0) {
+        free(wide);
+        return NULL;
+    }
+    return wide;
+}
+#endif
