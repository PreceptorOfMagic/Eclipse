diff --git a/util/uuidstr/uuidstr_android.c b/util/uuidstr/uuidstr_android.c
new file mode 100644
index 0000000..03af455
--- /dev/null
+++ b/util/uuidstr/uuidstr_android.c
@@ -0,0 +1,20 @@
+#include "uuidstr.h"
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+/* Android has no libuuid. A random (version 4, RFC 4122 variant) UUID from the kernel-seeded arc4random,
+ * spelled exactly as uuid_unparse() spells one: lowercase, 8-4-4-4-12. */
+bool uuidstr_random(uuidstr_t *dest) {
+    uint8_t b[16];
+    arc4random_buf(b, sizeof(b));
+    b[6] = (uint8_t) ((b[6] & 0x0f) | 0x40);
+    b[8] = (uint8_t) ((b[8] & 0x3f) | 0x80);
+    char text[UUIDSTR_CAPACITY];
+    snprintf(text, sizeof(text),
+             "%02x%02x%02x%02x-%02x%02x-%02x%02x-%02x%02x-%02x%02x%02x%02x%02x%02x",
+             b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7], b[8], b[9], b[10], b[11], b[12], b[13], b[14], b[15]);
+    uuidstr_fromstr(dest, text);
+    return true;
+}
