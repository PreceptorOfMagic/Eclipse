+/* State callbacks run on the mainloop thread with the loop lock held. A FAILED or
+ * TERMINATED transition that our own teardown did not cause stops the write requests
+ * silently, so count it for the final ledger. */
+static void PullContextState(pa_context *c, void *userdata) {
+    SS4S_AudioInstance *instance = userdata;
+    const pa_context_state_t state = pa_context_get_state(c);
+    if (!instance->closing && (state == PA_CONTEXT_FAILED || state == PA_CONTEXT_TERMINATED))
+        instance->pull.context_failures++;
+    pa_threaded_mainloop_signal(instance->loop, 0);
+}
+
+static void PullStreamState(pa_stream *s, void *userdata) {
+    SS4S_AudioInstance *instance = userdata;
+    const pa_stream_state_t state = pa_stream_get_state(s);
+    if (!instance->closing && (state == PA_STREAM_FAILED || state == PA_STREAM_TERMINATED))
+        instance->pull.stream_failures++;
+    pa_threaded_mainloop_signal(instance->loop, 0);
