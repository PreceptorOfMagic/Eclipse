+static unsigned long ndl_trace_now_ms(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (unsigned long) ts.tv_sec * 1000ul + (unsigned long) (ts.tv_nsec / 1000000ul);
+}
+
+static void ndl_trace_row(int rc, int rawBufLen, uint64_t intervalUs, uint64_t pts, size_t bytes) {
+    if (ndl_trace_state == 0) {
+        ndl_trace_state = -1;
+        if (access(AURORA_NDL_TRACE_SENTINEL, F_OK) == 0) {
+            ndl_trace_f = fopen(AURORA_NDL_TRACE_LOG, "w");
+            if (ndl_trace_f != NULL) {
