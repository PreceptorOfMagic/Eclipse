diff --git a/include/ss4s/hostrender.h b/include/ss4s/hostrender.h
new file mode 100644
index 0000000000000000000000000000000000000000..1480852e9617121f8acce87f81cdb29216c16383
--- /dev/null
+++ b/include/ss4s/hostrender.h
@@ -0,0 +1,49 @@
+#pragma once
+
+/*
+ * Host-side render handoff, for desktop hosts whose UI already owns the window.
+ *
+ * WHY. On webOS the video never touches the UI's renderer: starfish puts it on a hardware
+ * plane underneath. On a desktop there is one window and SDL allows exactly one
+ * SDL_Renderer per window, so a video module cannot make its own -- and it must not make
+ * its own WINDOW either. The app interrupts the session on SDL_WINDOWEVENT_FOCUS_LOST
+ * (src/app/app.c), so a second window tore every stream down 23ms after it started, and a
+ * window created on the decode thread would in any case never have its messages pumped:
+ * Windows delivers them to the creating thread.
+ *
+ * SO: the app publishes its SDL_Window, the module renders into that window's existing
+ * renderer, and -- because SDL_Renderer is not thread safe -- it does so ONLY when the app
+ * calls draw() from its own main thread, at the point in the LVGL flush where the render
+ * target is the window and the UI texture has not yet been blended on top. That is the
+ * same split moonlight-qt uses: decode on the stream thread, present on the main thread.
+ *
+ * The handoff goes through SDL hints because it needs no linkage in either direction: the
+ * module is a DLL loaded by ss4s, the app never sees its symbols, and both sides are in
+ * one process. The value is the pointer, printed with "%p" and read back with the same.
+ */
+
+#include <stdbool.h>
+
+/** App -> module: the SDL_Window the app's UI owns, as "%p". Set before any module loads. */
+#define SS4S_HINT_HOST_WINDOW "SS4S_HOST_WINDOW"
+
+/** Module -> app: a SS4S_HostRender*, as "%p". Set while a video instance is open. */
+#define SS4S_HINT_HOST_RENDER "SS4S_HOST_RENDER"
+
+typedef struct SS4S_HostRender {
+    /**
+     * True if a decoded frame has arrived that has not been presented yet. Cheap, and safe
+     * from any thread: the app polls it to decide whether to redraw, so that the main loop
+     * presents at the stream's rate rather than spinning.
+     */
+    bool (*pending)(void *context);
+
+    /**
+     * Draw the most recent frame into the CURRENT render target of the app's SDL_Renderer.
+     * MAIN THREAD ONLY. Does not present -- the app does that once, after blending its UI.
+     * Returns true if something was drawn.
+     */
+    bool (*draw)(void *context);
+
+    void *context;
+} SS4S_HostRender;
