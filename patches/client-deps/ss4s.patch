+/* --- driver ---------------------------------------------------------------------------------------------- */
+
+static int Init(int argc, char *argv[]) {
+    (void) argc;
+    (void) argv;
+    return 0;
+}
+
+static void Quit(void) {
+}
+
+static bool GetCapabilities(SS4S_VideoCapabilities *capabilities) {
+    EnsureProbed();
+    memset(capabilities, 0, sizeof(*capabilities));
+    /* Video on its own plane under a translucent UI, as on webOS (see the header). */
+    capabilities->transform = SS4S_VIDEO_CAP_TRANSFORM_UI_COMPOSITING;
+    capabilities->colorSpace = SS4S_VIDEO_CAP_COLORSPACE_BT2020 | SS4S_VIDEO_CAP_COLORSPACE_BT709;
+    capabilities->fullColorRange = false;
+    bool hdr_decoder = false;
+    for (int i = 0; i < DecoderCount; ++i) {
+        const DecoderEntry *e = &Decoders[i];
+        capabilities->codecs |= e->codec;
+        if (e->main10 && (e->codec == SS4S_VIDEO_H265 || e->codec == SS4S_VIDEO_AV1)) {
+            hdr_decoder = true;
+        }
+        /* The resolution list is decoder-aware: the largest the best H.265 (or else H.264) decoder takes. */
+        if (e->codec == SS4S_VIDEO_H265 || (e->codec == SS4S_VIDEO_H264 && capabilities->maxWidth == 0)) {
+            capabilities->maxWidth = (unsigned int) e->max_width;
+            capabilities->maxHeight = (unsigned int) e->max_height;
+        }
+    }
+    capabilities->hdr = hdr_decoder && DisplayHdr10;
+    return capabilities->codecs != SS4S_VIDEO_NONE;
+}
+
+static SS4S_VideoCodec GetPreferredCodecs(const SS4S_VideoInfo *info) {
+    (void) info;
+    EnsureProbed();
+    SS4S_VideoCodec codecs = SS4S_VIDEO_NONE;
+    for (int i = 0; i < DecoderCount; ++i) {
+        if (Decoders[i].hardware) {
+            codecs |= Decoders[i].codec;
+        }
+    }
+    return codecs;
+}
+
+/* HDR10 static metadata as MediaFormat's "hdr-static-info": ST 2086 + CTA-861.3, little endian, in the order
+ * Android's MediaFormat.KEY_HDR_STATIC_INFO documents (type 0, then R,G,B primaries, white point, max/min
+ * luminance, MaxCLL, MaxFALL). */
+static size_t HdrStaticInfo(const SS4S_VideoHDRInfo *hdr, uint8_t out[25]) {
+    uint16_t values[12] = {
+            (uint16_t) hdr->displayPrimariesX.r, (uint16_t) hdr->displayPrimariesY.r,
+            (uint16_t) hdr->displayPrimariesX.g, (uint16_t) hdr->displayPrimariesY.g,
+            (uint16_t) hdr->displayPrimariesX.b, (uint16_t) hdr->displayPrimariesY.b,
+            (uint16_t) hdr->whitePointX, (uint16_t) hdr->whitePointY,
+            (uint16_t) hdr->maxDisplayMasteringLuminance, (uint16_t) hdr->minDisplayMasteringLuminance,
+            (uint16_t) hdr->maxContentLightLevel, (uint16_t) hdr->maxPicAverageLightLevel,
+    };
+    out[0] = 0;
+    for (int i = 0; i < 12; ++i) {
+        out[1 + i * 2] = (uint8_t) (values[i] & 0xffu);
+        out[2 + i * 2] = (uint8_t) (values[i] >> 8);
+    }
+    return 25;
+}
+
+static void SetLowLatencyOptions(AMediaFormat *format, const DecoderEntry *decoder) {
+    /* Moonlight for Android, MediaCodecHelper.setDecoderLowLatencyOptions(). Unknown keys are ignored, so the
+     * vendor keys are set only for their own decoders to keep the log readable. */
+    AMediaFormat_setInt32(format, "priority", 0);                  /* KEY_PRIORITY: real time */
+    AMediaFormat_setInt32(format, "operating-rate", 0x7fff);        /* KEY_OPERATING_RATE: as fast as possible */
+    if (decoder->low_latency) {
+        AMediaFormat_setInt32(format, "low-latency", 1);           /* KEY_LOW_LATENCY (Android 11) */
+    }
+    const char *n = decoder->name;
+    if (strncasecmp(n, "omx.qcom", 8) == 0 || strncasecmp(n, "c2.qti", 6) == 0) {
+        AMediaFormat_setInt32(format, "vendor.qti-ext-dec-low-latency.enable", 1);
+        AMediaFormat_setInt32(format, "vendor.qti-ext-dec-picture-order.enable", 1);
+    } else if (strncasecmp(n, "omx.hisi", 8) == 0 || strncasecmp(n, "c2.hisi", 7) == 0) {
+        AMediaFormat_setInt32(format, "vendor.hisi-ext-low-latency-video-dec.video-scene-for-low-latency-req", 1);
+        AMediaFormat_setInt32(format, "vendor.hisi-ext-low-latency-video-dec.video-scene-for-low-latency-rdy", -1);
+    } else if (strncasecmp(n, "omx.exynos", 10) == 0 || strncasecmp(n, "c2.exynos", 9) == 0) {
+        AMediaFormat_setInt32(format, "vendor.rtc-ext-dec-low-latency.enable", 1);
+    } else if (strncasecmp(n, "omx.amlogic", 11) == 0 || strncasecmp(n, "c2.amlogic", 10) == 0) {
+        AMediaFormat_setInt32(format, "vendor.low-latency.enable", 1);
+    }
+}
+
+static void *RenderThread(void *arg);
+
+static void StopCodecLocked(SS4S_VideoInstance *instance) {
+    if (instance->render_running) {
+        atomic_store(&instance->stop, true);
+        pthread_mutex_unlock(&instance->lock);
+        pthread_join(instance->render_thread, NULL);
+        pthread_mutex_lock(&instance->lock);
+        instance->render_running = false;
+    }
+    if (instance->mc != NULL) {
+        AMediaCodec_stop(instance->mc);
+        AMediaCodec_delete(instance->mc);
+        instance->mc = NULL;
+    }
+    instance->params.len = 0;
+}
+
+static bool StartCodecLocked(SS4S_VideoInstance *instance) {
+    const DecoderEntry *decoder = instance->decoder;
+    AMediaCodec *mc = decoder != NULL ? AMediaCodec_createCodecByName(decoder->name) : NULL;
+    if (mc == NULL) {
+        mc = AMediaCodec_createDecoderByType(instance->mime);
+    }
+    if (mc == NULL) {
+        LogMsg(SS4S_LogLevelError, "No decoder could be created for %s", instance->mime);
+        return false;
+    }
+    AMediaFormat *format = AMediaFormat_new();
+    AMediaFormat_setString(format, AMEDIAFORMAT_KEY_MIME, instance->mime);
+    AMediaFormat_setInt32(format, AMEDIAFORMAT_KEY_WIDTH, instance->width);
+    AMediaFormat_setInt32(format, AMEDIAFORMAT_KEY_HEIGHT, instance->height);
+    if (instance->fps > 0) {
+        AMediaFormat_setInt32(format, AMEDIAFORMAT_KEY_FRAME_RATE, instance->fps);
+    }
+    /* A whole access unit per input buffer: a 4K IDR at a high bitrate is several megabytes. */
+    int64_t max_input = (int64_t) instance->width * instance->height * 3 / 2;
+    if (max_input < 2 * 1024 * 1024) max_input = 2 * 1024 * 1024;
+    if (max_input > 12 * 1024 * 1024) max_input = 12 * 1024 * 1024;
+    AMediaFormat_setInt32(format, AMEDIAFORMAT_KEY_MAX_INPUT_SIZE, (int32_t) max_input);
+    if (decoder != NULL) {
+        SetLowLatencyOptions(format, decoder);
+    }
+    /* Colour: MediaFormat's constants (COLOR_STANDARD_BT709 = 1, BT2020 = 6; COLOR_TRANSFER_SDR_VIDEO = 3,
+     * ST2084 = 6; COLOR_RANGE_LIMITED = 2). The bitstream carries the same; these let the display path know
+     * before the first picture, which is what switches a TV into HDR without a flash. */
+    if (instance->have_hdr) {
+        uint8_t info[25];
+        const size_t len = HdrStaticInfo(&instance->hdr, info);
+        AMediaFormat_setInt32(format, "color-standard", 6);
+        AMediaFormat_setInt32(format, "color-transfer", 6);
+        AMediaFormat_setInt32(format, "color-range", 2);
+        AMediaFormat_setBuffer(format, "hdr-static-info", info, len);
+    } else {
+        AMediaFormat_setInt32(format, "color-standard", 1);
+        AMediaFormat_setInt32(format, "color-transfer", 3);
+        AMediaFormat_setInt32(format, "color-range", 2);
+    }
+    media_status_t status = AMediaCodec_configure(mc, format, instance->window, NULL, 0);
+    AMediaFormat_delete(format);
+    if (status != AMEDIA_OK) {
+        LogMsg(SS4S_LogLevelError, "configure(%s %dx%d) failed: %d", decoder ? decoder->name : instance->mime,
+               instance->width, instance->height, (int) status);
+        AMediaCodec_delete(mc);
+        return false;
+    }
+    status = AMediaCodec_start(mc);
+    if (status != AMEDIA_OK) {
+        LogMsg(SS4S_LogLevelError, "start() failed: %d", (int) status);
+        AMediaCodec_delete(mc);
+        return false;
+    }
+    instance->mc = mc;
+    instance->params.len = 0;
+    instance->need_keyframe = true;
+    atomic_store(&instance->stop, false);
+    if (pthread_create(&instance->render_thread, NULL, RenderThread, instance) != 0) {
+        LogMsg(SS4S_LogLevelError, "render thread: %s", strerror(errno));
+        AMediaCodec_stop(mc);
+        AMediaCodec_delete(mc);
+        instance->mc = NULL;
+        return false;
+    }
+    instance->render_running = true;
+    LogMsg(SS4S_LogLevelInfo, "Started %s for %s %dx%d@%d%s", decoder ? decoder->name : "(default)", instance->mime,
+           instance->width, instance->height, instance->fps, instance->have_hdr ? " HDR10" : "");
+    return true;
+}
+
+/* Render each decoded picture as soon as it exists. When several are waiting at once -- the decoder caught up
+ * after a stall -- only the newest is shown: showing the others would only add their age to every later
+ * picture. Moonlight for Android's "lowest latency" frame pacing does the same. */
+static void *RenderThread(void *arg) {
+    SS4S_VideoInstance *instance = arg;
+    while (!atomic_load(&instance->stop)) {
+        AMediaCodecBufferInfo info;
+        ssize_t index = AMediaCodec_dequeueOutputBuffer(instance->mc, &info, OUTPUT_WAIT_US);
+        if (index == AMEDIACODEC_INFO_OUTPUT_FORMAT_CHANGED) {
+            AMediaFormat *format = AMediaCodec_getOutputFormat(instance->mc);
+            if (format != NULL) {
+                LogMsg(SS4S_LogLevelInfo, "Output format: %s", AMediaFormat_toString(format));
+                AMediaFormat_delete(format);
+            }
+            continue;
+        }
+        if (index < 0) {
+            continue;   /* INFO_TRY_AGAIN_LATER, OUTPUT_BUFFERS_CHANGED */
+        }
+        for (;;) {
+            AMediaCodecBufferInfo next;
+            ssize_t newer = AMediaCodec_dequeueOutputBuffer(instance->mc, &next, 0);
+            if (newer < 0) {
+                break;
+            }
+            AMediaCodec_releaseOutputBuffer(instance->mc, (size_t) index, false);
+            instance->dropped_output++;
+            index = newer;
+            info = next;
+        }
+        AMediaCodec_releaseOutputBuffer(instance->mc, (size_t) index, true);
+        instance->rendered++;
+        if (instance->context != NULL && instance->context->player != NULL && LibContext != NULL &&
+            LibContext->VideoStats.ReportFrame != NULL && info.presentationTimeUs > 0) {
+            /* Presentation time is the feed time (Feed() below): this is the decoder's own latency. */
+            const uint64_t now = MonotonicUs();
+            if (now > (uint64_t) info.presentationTimeUs) {
+                LibContext->VideoStats.ReportFrame(instance->context->player,
+                                                   (uint32_t) (now - (uint64_t) info.presentationTimeUs));
+            }
+        }
+    }
+    return NULL;
+}
+
+static SS4S_VideoOpenResult Open(const SS4S_VideoInfo *info, const SS4S_VideoExtraInfo *extraInfo,
+                                 SS4S_VideoInstance **out, SS4S_PlayerContext *context) {
+    (void) extraInfo;
+    EnsureProbed();
+    const char *mime = MimeOf(info->codec);
+    if (mime == NULL) {
+        return SS4S_VIDEO_OPEN_UNSUPPORTED_CODEC;
+    }
+    const DecoderEntry *decoder = DecoderFor(info->codec);
+    if (decoder == NULL) {
+        LogMsg(SS4S_LogLevelError, "No %s decoder on this device", SS4S_VideoCodecName(info->codec));
+        return SS4S_VIDEO_OPEN_UNSUPPORTED_CODEC;
+    }
+    SS4S_VideoInstance *instance = calloc(1, sizeof(*instance));
+    if (instance == NULL) {
+        return SS4S_VIDEO_OPEN_ERROR;
+    }
+    pthread_mutex_init(&instance->lock, NULL);
+    instance->context = context;
+    instance->codec = info->codec;
+    instance->mime = mime;
+    instance->width = info->width;
+    instance->height = info->height;
+    instance->fps = info->frameRateDenominator > 0 ? info->frameRateNumerator / info->frameRateDenominator : 0;
+    instance->decoder = decoder;
+    instance->window = AcquireWindow(info->width, info->height);
+    if (instance->window == NULL) {
+        LogMsg(SS4S_LogLevelError, "The video surface is not available");
+        pthread_mutex_destroy(&instance->lock);
+        free(instance);
+        return SS4S_VIDEO_OPEN_ERROR;
+    }
+    pthread_mutex_lock(&instance->lock);
+    const bool started = StartCodecLocked(instance);
+    pthread_mutex_unlock(&instance->lock);
+    if (!started) {
+        ANativeWindow_release(instance->window);
+        pthread_mutex_destroy(&instance->lock);
+        free(instance);
+        return SS4S_VIDEO_OPEN_ERROR;
+    }
+    *out = instance;
+    return SS4S_VIDEO_OPEN_OK;
+}
+
+/* --- feeding ---------------------------------------------------------------------------------------------- */
+
+/* Annex B: the next start code at or after @p from; *sc_len is 3 or 4. Returns len if none. */
+static size_t NextStartCode(const unsigned char *data, size_t len, size_t from, size_t *sc_len) {
+    for (size_t i = from; i + 3 <= len; ++i) {
+        if (data[i] == 0 && data[i + 1] == 0) {
+            if (data[i + 2] == 1) {
+                *sc_len = 3;
+                return i;
+            }
+            if (i + 4 <= len && data[i + 2] == 0 && data[i + 3] == 1) {
+                *sc_len = 4;
+                return i;
+            }
+        }
+    }
+    *sc_len = 0;
+    return len;
+}
+
+static bool IsParameterSet(SS4S_VideoCodec codec, unsigned char header) {
+    if (codec == SS4S_VIDEO_H264) {
+        const unsigned type = header & 0x1fu;
+        return type == 7 || type == 8;            /* SPS, PPS */
+    }
+    if (codec == SS4S_VIDEO_H265) {
+        const unsigned type = (header >> 1) & 0x3fu;
+        return type == 32 || type == 33 || type == 34;   /* VPS, SPS, PPS */
+    }
+    return false;
+}
+
+/* How many leading bytes of an H.264/H.265 access unit are parameter sets: Moonlight sends them in front of
+ * every IDR, and a co-op composite in front of every picture (its own, rewritten ones). They go to the decoder
+ * as a codec-config buffer of their own, as Moonlight for Android does -- some decoders (Tegra among them) do
+ * not take parameter sets in-band inside a picture's buffer -- and only when they change. */
+static size_t LeadingParameterSets(SS4S_VideoCodec codec, const unsigned char *data, size_t len) {
+    if (codec != SS4S_VIDEO_H264 && codec != SS4S_VIDEO_H265) {
+        return 0;
+    }
+    size_t sc_len = 0, pos = NextStartCode(data, len, 0, &sc_len), end = 0;
+    while (pos < len) {
+        const size_t nal = pos + sc_len;
+        if (nal >= len || !IsParameterSet(codec, data[nal])) {
+            break;
+        }
+        size_t next_len = 0;
+        const size_t next = NextStartCode(data, len, nal, &next_len);
+        end = next;
+        pos = next;
+        sc_len = next_len;
+    }
+    return end;
+}
+
+static bool QueueBuffer(SS4S_VideoInstance *instance, const unsigned char *data, size_t size, uint64_t pts,
+                        uint32_t flags) {
+    for (int tries = 0; tries < INPUT_WAIT_TRIES; ++tries) {
+        const ssize_t index = AMediaCodec_dequeueInputBuffer(instance->mc, INPUT_WAIT_US);
+        if (index == AMEDIACODEC_INFO_TRY_AGAIN_LATER) {
+            continue;
+        }
+        if (index < 0) {
+            /* The codec is in an error state: restart it at the next keyframe. */
+            instance->errors++;
+            instance->reconfigure_at_keyframe = true;
+            LogMsg(SS4S_LogLevelError, "dequeueInputBuffer: %d", (int) index);
+            return false;
+        }
+        size_t capacity = 0;
+        uint8_t *buffer = AMediaCodec_getInputBuffer(instance->mc, (size_t) index, &capacity);
+        if (buffer == NULL || capacity < size) {
+            /* Give the buffer back empty; this picture cannot be decoded. */
+            AMediaCodec_queueInputBuffer(instance->mc, (size_t) index, 0, 0, pts, 0);
+            LogMsg(SS4S_LogLevelWarn, "Access unit of %zu bytes exceeds the decoder's %zu-byte buffer", size, capacity);
+            return false;
+        }
+        memcpy(buffer, data, size);
+        if (AMediaCodec_queueInputBuffer(instance->mc, (size_t) index, 0, size, pts, flags) != AMEDIA_OK) {
+            instance->errors++;
+            instance->reconfigure_at_keyframe = true;
+            return false;
+        }
+        return true;
+    }
+    instance->lost_input++;
+    return false;
+}
+
+static SS4S_VideoFeedResult Feed(SS4S_VideoInstance *instance, const unsigned char *data, size_t size,
+                                 SS4S_VideoFeedFlags flags) {
+    const bool keyframe = (flags & SS4S_VIDEO_FEED_DATA_KEYFRAME) != 0;
+    pthread_mutex_lock(&instance->lock);
+    if (keyframe && instance->reconfigure_at_keyframe) {
+        /* The HDR state changed, or the codec failed: restart at a picture that needs nothing before it. */
+        instance->reconfigure_at_keyframe = false;
+        StopCodecLocked(instance);
+        if (instance->restart_failing_since != 0) {
+            /* The last start failed: the activity may have a new surface by now (it came back to the screen). */
+            const int width = instance->width, height = instance->height;
+            pthread_mutex_unlock(&instance->lock);
+            ANativeWindow *window = CurrentWindow(width, height, NULL);
+            pthread_mutex_lock(&instance->lock);
+            if (window != NULL) {
+                if (instance->window != NULL) {
+                    ANativeWindow_release(instance->window);
+                }
+                instance->window = window;
+            }
+        }
+        if (!StartCodecLocked(instance)) {
+            const uint64_t now = MonotonicUs();
+            if (instance->restart_failing_since == 0) {
+                instance->restart_failing_since = now;
+            }
+            if (now - instance->restart_failing_since < RESTART_GRACE_US) {
+                /* Drop pictures and try again at the next keyframe: if the surface went with the screen, the
+                 * session ends cleanly as the app goes to the background; if it comes back, the stream goes on. */
+                instance->reconfigure_at_keyframe = true;
+                pthread_mutex_unlock(&instance->lock);
+                return SS4S_VIDEO_FEED_NOT_READY;
+            }
+            pthread_mutex_unlock(&instance->lock);
+            return SS4S_VIDEO_FEED_ERROR;
+        }
+        if (instance->restart_failing_since != 0) {
+            LogMsg(SS4S_LogLevelInfo, "Decoder restarted after %.1f s", (MonotonicUs() - instance->restart_failing_since) / 1e6);
+        }
+        instance->restart_failing_since = 0;
+    }
+    if (instance->mc == NULL) {
+        const bool retrying = instance->reconfigure_at_keyframe && instance->restart_failing_since != 0 &&
+                              MonotonicUs() - instance->restart_failing_since < RESTART_GRACE_US;
+        pthread_mutex_unlock(&instance->lock);
+        /* Waiting to retry the start: ask for the keyframe it needs (the session spaces the requests out). */
+        return retrying ? SS4S_VIDEO_FEED_REQUEST_KEYFRAME : SS4S_VIDEO_FEED_ERROR;
+    }
+    if (instance->need_keyframe && !keyframe) {
+        /* Everything until the next IDR refers to a picture the decoder never had. */
+        pthread_mutex_unlock(&instance->lock);
+        return SS4S_VIDEO_FEED_REQUEST_KEYFRAME;
+    }
+    const uint64_t pts = MonotonicUs();
+    size_t offset = 0;
+    const size_t params = LeadingParameterSets(instance->codec, data, size);
+    if (params > 0 && params < size) {
+        if (params <= sizeof(instance->params.data) &&
+            (params != instance->params.len || memcmp(instance->params.data, data, params) != 0)) {
+            if (!QueueBuffer(instance, data, params, pts, AMEDIACODEC_BUFFER_FLAG_CODEC_CONFIG)) {
+                instance->need_keyframe = true;
+                pthread_mutex_unlock(&instance->lock);
+                return SS4S_VIDEO_FEED_REQUEST_KEYFRAME;
+            }
+            memcpy(instance->params.data, data, params);
+            instance->params.len = params;
+            offset = params;
+        } else if (params <= sizeof(instance->params.data)) {
+            offset = params;   /* the decoder already has exactly these */
+        }
+        /* Larger than the cache: left in-band, as the stream carried them. */
+    }
+    const bool queued = QueueBuffer(instance, data + offset, size - offset, pts, 0);
+    instance->fed++;
+    if (!queued) {
+        instance->need_keyframe = true;
+        pthread_mutex_unlock(&instance->lock);
+        return SS4S_VIDEO_FEED_REQUEST_KEYFRAME;
+    }
+    if (keyframe) {
+        instance->need_keyframe = false;
+    }
+    pthread_mutex_unlock(&instance->lock);
+    return SS4S_VIDEO_FEED_OK;
+}
+
+static bool SizeChanged(SS4S_VideoInstance *instance, int width, int height) {
+    if (width <= 0 || height <= 0) {
+        return false;
+    }
+    pthread_mutex_lock(&instance->lock);
+    bool ok = true;
+    if (width != instance->width || height != instance->height) {
+        instance->width = width;
+        instance->height = height;
+        StopCodecLocked(instance);
+        pthread_mutex_unlock(&instance->lock);
+        jclass cls = NULL;
+        JNIEnv *env = ActivityEnv(&cls);
+        if (env != NULL) {
+            jmethodID size = (*env)->GetStaticMethodID(env, cls, "setVideoSize", "(II)V");
+            if (size != NULL) {
+                (*env)->CallStaticVoidMethod(env, cls, size, (jint) width, (jint) height);
+            }
+            ClearException(env, "setVideoSize");
+            (*env)->DeleteLocalRef(env, cls);
+        }
+        pthread_mutex_lock(&instance->lock);
+        ok = StartCodecLocked(instance);
+    }
+    pthread_mutex_unlock(&instance->lock);
+    return ok;
+}
+
+static bool SetHDRInfo(SS4S_VideoInstance *instance, const SS4S_VideoHDRInfo *info) {
+    pthread_mutex_lock(&instance->lock);
+    const bool had = instance->have_hdr;
+    instance->have_hdr = info != NULL;
+    if (info != NULL) {
+        const bool changed = !had || memcmp(&instance->hdr, info, sizeof(*info)) != 0;
+        instance->hdr = *info;
+        if (changed) {
+            instance->reconfigure_at_keyframe = true;
+        }
+    } else if (had) {
+        instance->reconfigure_at_keyframe = true;
+    }
+    pthread_mutex_unlock(&instance->lock);
+    return true;
+}
+
+static bool SetDisplayArea(SS4S_VideoInstance *instance, const SS4S_VideoRect *src, const SS4S_VideoRect *dst) {
+    (void) instance;
+    (void) src;
+    (void) dst;
+    return false;   /* the plane always fills the screen (letterboxed by setVideoSize) */
+}
+
+static void Close(SS4S_VideoInstance *instance) {
+    pthread_mutex_lock(&instance->lock);
+    StopCodecLocked(instance);
+    pthread_mutex_unlock(&instance->lock);
+    LogMsg(SS4S_LogLevelInfo, "Closed: fed %lu, rendered %lu, older pictures skipped %lu, input lost %lu, errors %lu",
+           instance->fed, instance->rendered, instance->dropped_output, instance->lost_input, instance->errors);
+    if (instance->window != NULL) {
+        ANativeWindow_release(instance->window);
+    }
+    pthread_mutex_destroy(&instance->lock);
+    free(instance);
+}
+
+/* --- player context: only so Open() learns its SS4S_Player for the decoder-latency statistics ----------- */
+
+static SS4S_PlayerContext *CreatePlayerContext(SS4S_Player *player) {
+    SS4S_PlayerContext *context = calloc(1, sizeof(*context));
+    if (context != NULL) {
+        context->player = player;
+    }
+    return context;
+}
+
+static void DestroyPlayerContext(SS4S_PlayerContext *context) {
+    free(context);
+}
+
+static const SS4S_PlayerDriver MediaCodecPlayerDriver = {
+        .Create = CreatePlayerContext,
+        .Destroy = DestroyPlayerContext,
+};
+
+static const SS4S_VideoDriver MediaCodecVideoDriver = {
+        .Base = {
+                .Init = Init,
+                .Quit = Quit,
+        },
+        .GetCapabilities = GetCapabilities,
+        .GetPreferredCodecs = GetPreferredCodecs,
+        .Open = Open,
+        .Feed = Feed,
+        .SizeChanged = SizeChanged,
+        .SetHDRInfo = SetHDRInfo,
+        .SetDisplayArea = SetDisplayArea,
+        .Close = Close,
+};
+
+SS4S_EXPORTED bool SS4S_ModuleOpen_MEDIACODEC(SS4S_Module *module, const SS4S_LibraryContext *context) {
+    module->Name = "mediacodec";
+    module->VideoDriver = &MediaCodecVideoDriver;
+    module->PlayerDriver = &MediaCodecPlayerDriver;
+    LibContext = context;
+    return true;
+}
+
+SS4S_EXPORTED SS4S_ModuleCheckFlag SS4S_ModuleCheck_MEDIACODEC(SS4S_ModuleCheckFlag flags) {
+    /* libmediandk is part of every Android release this app runs on; whether a decoder exists is
+     * GetCapabilities()'s question, asked once SDL's Java side is up. */
+    return flags & SS4S_MODULE_CHECK_VIDEO;
+}
diff --git a/modules/ffmpeg/CMakeLists.txt b/modules/ffmpeg/CMakeLists.txt
new file mode 100644
index 0000000000000000000000000000000000000000..c9b2b760ecf9273fa2fb2f7abf57f9fa45139ab9
--- /dev/null
+++ b/modules/ffmpeg/CMakeLists.txt
@@ -0,0 +1,60 @@
+# Desktop video backend. ss4s has none: webos/mmal/steamlink cover their own hardware and
+# the sdl module is audio-only. Decode and presentation are both modelled on moonlight-qt,
+# the native PC client (see the header of ffmpegvid.c).
+find_package(PkgConfig REQUIRED)
+if (WIN32)
+    # A Windows build without these libraries would produce an apparently healthy client
+    # with no usable video decoder. Make that a configure-time failure, not a runtime trap.
+    pkg_check_modules(LIBAVCODEC REQUIRED libavcodec)
+    pkg_check_modules(LIBAVUTIL REQUIRED libavutil)
+    # D3D11VA returns NV12/P010 hardware frames.  The current host renderer owns an
+    # SDL IYUV texture, so the Windows bridge downloads and normalizes those frames
+    # with libswscale until direct D3D11 texture presentation is implemented.
+    pkg_check_modules(LIBSWSCALE REQUIRED libswscale)
+else ()
+    # Preserve the existing optional desktop module on non-Windows platforms. Linux can
+    # replace only the hardware-device/presentation seam when its backend is added.
+    pkg_check_modules(LIBAVCODEC libavcodec)
+    pkg_check_modules(LIBAVUTIL libavutil)
+    # Linux GPU decode (NVDEC / VA-API, ffmpegvid.c) downloads frames and normalizes them with
+    # libswscale exactly like the Windows bridge. Without libswscale the module stays software-only.
+    pkg_check_modules(LIBSWSCALE libswscale)
+    # VA-API frames presented without a readback (ffmpegvid.c host_import_dmabuf). The libva
+    # FFmpeg's own VA-API decoder already loads; without it VA-API frames are read back as before.
+    pkg_check_modules(LIBVA libva)
+endif ()
+
+if (LIBAVCODEC_FOUND AND LIBAVUTIL_FOUND AND SDL2_FOUND AND (NOT WIN32 OR LIBSWSCALE_FOUND))
+    if (WIN32)
+        set(FFMPEG_DISPLAY_NAME "D3D11VA (FFmpeg)")
+    else ()
+        set(FFMPEG_DISPLAY_NAME "FFmpeg")
+    endif ()
+    ss4s_add_module(ffmpeg FOR_VIDEO DISPLAY_NAME "${FFMPEG_DISPLAY_NAME}" SOURCES ffmpegvid.c WEIGHT 50)
+    if (NOT SS4S_MODULE_TARGET)
+        return()
+    endif ()
+    target_include_directories(${SS4S_MODULE_TARGET} SYSTEM PRIVATE
+            ${LIBAVCODEC_INCLUDE_DIRS} ${LIBAVUTIL_INCLUDE_DIRS} ${LIBSWSCALE_INCLUDE_DIRS}
+            ${SDL2_INCLUDE_DIRS})
+    target_link_directories(${SS4S_MODULE_TARGET} PRIVATE
+            ${LIBAVCODEC_LIBRARY_DIRS} ${LIBAVUTIL_LIBRARY_DIRS} ${LIBSWSCALE_LIBRARY_DIRS})
+    target_link_libraries(${SS4S_MODULE_TARGET} PRIVATE
+            ${LIBAVCODEC_LIBRARIES} ${LIBAVUTIL_LIBRARIES} ${LIBSWSCALE_LIBRARIES}
+            ${SDL2_LIBRARIES})
+    if (NOT WIN32 AND LIBSWSCALE_FOUND)
+        target_compile_definitions(${SS4S_MODULE_TARGET} PRIVATE SS4S_FFMPEG_HWACCEL=1)
+        if (LIBVA_FOUND)
+            # libEGL is not linked: it is looked up at run time in the process, where SDL loaded it.
+            target_include_directories(${SS4S_MODULE_TARGET} SYSTEM PRIVATE ${LIBVA_INCLUDE_DIRS})
+            target_link_directories(${SS4S_MODULE_TARGET} PRIVATE ${LIBVA_LIBRARY_DIRS})
+            target_link_libraries(${SS4S_MODULE_TARGET} PRIVATE ${LIBVA_LIBRARIES} ${CMAKE_DL_LIBS})
+            target_compile_definitions(${SS4S_MODULE_TARGET} PRIVATE SS4S_FFMPEG_VAAPI_DMABUF=1)
+        endif ()
+    endif ()
+    if (WIN32)
+        # System SDK import libraries only: used to identify the adapter behind FFmpeg's
+        # D3D11VA device and reject WARP/software or remote adapters before accepting a stream.
+        target_link_libraries(${SS4S_MODULE_TARGET} PRIVATE dxgi dxguid)
+    endif ()
+endif ()
diff --git a/modules/ffmpeg/ffmpegvid.c b/modules/ffmpeg/ffmpegvid.c
new file mode 100644
index 0000000000000000000000000000000000000000..da87fda51edb0e5fbb7e8449b4c49af69d0d6a70
--- /dev/null
+++ b/modules/ffmpeg/ffmpegvid.c
@@ -0,0 +1,1839 @@
+/*
+ * SS4S video module: FFmpeg decode + SDL presentation, for desktop platforms.
+ *
+ * WHY THIS EXISTS. ss4s ships video backends for the platforms it grew up on -- webos
+ * (starfish), mmal (Raspberry Pi), steamlink -- and none for a generic desktop. The app
+ * takes its entire video capability from ss4s, so without one the client builds, the UI
+ * runs, and it reports "No working decoder" with Video Settings reading "using (null)".
+ *
+ * WHAT IS COPIED RATHER THAN INVENTED. The decode loop and the presentation path are both
+ * taken from moonlight-qt, the native PC client, because it has solved exactly this on
+ * exactly this platform: send_packet/receive_frame around an AVCodecContext, strict
+ * get_format selection that cannot silently fall back from hardware, D3D11VA device
+ * contexts on Windows, and SDL presentation (moonlight-qt commit
+ * 032529d782242e3833e0b3b147dbbf96e878e3ca, app/streaming/video/ffmpeg.cpp,
+ * ffmpeg-renderers/d3d11va.cpp, and ffmpeg-renderers/sdlvid.cpp). What is written here
+ * is only the glue between those established paths and the SS4S_VideoDriver contract.
+ *
+ * Windows deliberately fails closed if D3D11VA cannot be selected.  Software decode is
+ * available only for diagnosis by setting ECLIPSE_DIAGNOSTIC_VIDEO_DECODER=software;
+ * the module emits a warning that such a run is not a valid Windows functional test.
+ * D3D11VA output is currently downloaded and converted to IYUV for the shared SDL
+ * renderer.  Decode is on the GPU, but presentation still pays a GPU->CPU readback and
+ * (normally NV12/P010 -> YUV420P) conversion until the host-render contract can carry a
+ * D3D11 texture directly.
+ *
+ * Linux decodes on the GPU where it can (NVDEC, then VA-API) through the same readback and
+ * IYUV normalisation, but FALLS BACK to software instead of failing closed: a random Linux
+ * machine may have no usable driver at all. See linux_open_hwaccel().
+ *
+ * THIS DOES NOT OWN A WINDOW, AND THAT IS THE WHOLE POINT. It used to create one, which
+ * cost two evenings: the new window took focus, the app saw SDL_WINDOWEVENT_FOCUS_LOST on
+ * its own window and called session_interrupt(STREAMING_INTERRUPT_BACKGROUND), so every
+ * stream tore itself down 23ms in with "Control stream connection failed: 10004" and "No
+ * video traffic was ever received" -- a host-shaped failure with an entirely client-side
+ * cause. It renders into the app's window instead, through ss4s/hostrender.h; read that
+ * file for the contract and for why presentation happens on the app's thread.
+ */
+#include "ss4s/modapi.h"
+#include "ss4s/hostrender.h"
+
+#ifdef _WIN32
+#define COBJMACROS
+#endif
+
+#include <SDL.h>
+#include <libavcodec/avcodec.h>
+#include <libavutil/pixdesc.h>
+
+#ifdef _WIN32
+#include <libavutil/hwcontext.h>
+#include <libavutil/hwcontext_d3d11va.h>
+#include <libswscale/swscale.h>
+
+#include <dxgi1_2.h>
+
+#define DIAGNOSTIC_DECODER_ENV "ECLIPSE_DIAGNOSTIC_VIDEO_DECODER"
+#endif
+
+#if defined(__linux__) && defined(SS4S_FFMPEG_HWACCEL)
+#define LINUX_HWACCEL 1
+#include <libavutil/hwcontext.h>
+#include <libswscale/swscale.h>
+
+#define DIAGNOSTIC_DECODER_ENV "ECLIPSE_DIAGNOSTIC_VIDEO_DECODER"
+#endif
+
+#if defined(LINUX_HWACCEL) && defined(SS4S_FFMPEG_VAAPI_DMABUF)
+/* VA-API ZERO-COPY PRESENTATION (host_import_dmabuf). Reading a 4K frame back to the CPU, converting
+ * it to IYUV and uploading it again cost ~17 ms per frame on moonlight-common-c's receive thread
+ * (Feed runs there: CAPABILITY_DIRECT_SUBMIT), and the video socket overflowed behind it -- 26% of
+ * packets dropped at 4K60 on an RX Vega (measured 2026-10-23, docs L13). The decoded surface is
+ * instead exported as DMA-BUF planes and bound into the planes of an SDL NV12 texture, which SDL then
+ * draws with its own NV12 shader -- the moonlight-qt/mpv approach, kept inside SDL's renderer. EGL is
+ * looked up in the process (SDL loaded it for its context), so a GLX context simply falls back. */
+#define LINUX_DMABUF 1
+#define SDL_USE_BUILTIN_OPENGL_DEFINITIONS 1   /* SDL's bundled EGL definitions, not <EGL/egl.h> */
+#include <libavutil/hwcontext_vaapi.h>
+#include <va/va_drmcommon.h>
+#include <SDL_egl.h>
+#include <SDL_opengl.h>
+#include <dlfcn.h>
+#include <unistd.h>
+#endif
+
+#include <stdio.h>
+#include <limits.h>
+#include <stdlib.h>
+#include <string.h>
+
+static const SS4S_LibraryContext *LibContext = NULL;
+
+static bool host_pending(void *context);
+
+static bool host_draw(void *context);
+
+/* The hint must never expose an object whose lifetime is tied to one stream. The app reads
+ * the pointer and calls it on its UI thread while Close() runs on the stream thread; clearing
+ * the hint cannot revoke a pointer the UI already fetched. Keep this proxy alive for the whole
+ * driver lifetime instead. Its lock is held across each callback, so detaching an instance in
+ * Close() waits for an in-flight draw to finish before the instance, texture or mutex is freed. */
+typedef struct FFmpegHostRenderProxy {
+    SS4S_HostRender render;
+    SDL_mutex *lock;
+    SS4S_VideoInstance *instance;
+    struct RetiredTexture *retired_head;
+    struct RetiredTexture *retired_tail;
+    SDL_threadID render_thread_id;   /* NOT Uint32: an unsigned long, a 64-bit pthread_t on Linux */
+} FFmpegHostRenderProxy;
+
+typedef struct RetiredTexture {
+    SDL_Texture *texture;
+    struct RetiredTexture *next;
+} RetiredTexture;
+
+static FFmpegHostRenderProxy *HostRenderProxy = NULL;
+
+#ifdef _WIN32
+static bool WindowsCapabilitiesProbed = false;
+static SS4S_VideoCodec WindowsHardwareCodecs = SS4S_VIDEO_NONE;
+static SS4S_VideoCodec probe_windows_codecs(void);
+#endif
+
+struct SS4S_VideoInstance {
+    AVCodecContext *codec_ctx;
+    AVPacket *packet;
+    AVFrame *frame;     /* decode target, stream thread only */
+
+    SDL_mutex *lock;
+    AVFrame *shared;    /* latest decoded frame, handed to the app's thread under `lock` */
+    bool has_new;
+
+    SDL_Renderer *renderer;
+    SDL_Texture *texture;
+    int tex_w, tex_h;
+
+    /* Counted, not guessed: a black window with a healthy connection could be no packets,
+     * no decoded frames, or frames that are drawn and then covered. One line every 120
+     * tells which. */
+    unsigned long fed, decoded, corrupt_frames, drawn;
+    unsigned int last_corrupt_frame_flags, last_decode_error_flags;
+    int mean_luma;
+
+    /* The player this decoder feeds, for SS4S's video stats: feed -> decoded frame ready to
+     * draw, which the client shows as "Decoder latency" (issue #32; NULL = not reported). */
+    SS4S_Player *player;
+
+#ifdef _WIN32
+    AVBufferRef *hw_device_ctx;
+    enum AVPixelFormat hw_pix_fmt;
+    AVFrame *download;  /* GPU -> CPU transfer target */
+    AVFrame *i420;      /* normalized frame consumed by SDL_UpdateYUVTexture */
+    struct SwsContext *sws;
+    bool use_d3d11va;
+    bool hardware_confirmed;
+    bool fatal_decode_error;
+    unsigned long hardware_frames, readbacks, i420_conversions;
+    char adapter_description[384];
+    unsigned int adapter_vendor, adapter_device;
+#endif
+#ifdef LINUX_HWACCEL
+    AVBufferRef *hw_device_ctx;
+    enum AVPixelFormat hw_pix_fmt;  /* AV_PIX_FMT_CUDA / _VAAPI while a GPU path is armed; NONE = software */
+    const char *hw_path;            /* "nvdec", "vaapi" or "software"; host_draw reads it under `lock` */
+    AVFrame *download;              /* GPU -> CPU transfer target */
+    AVFrame *i420;                  /* normalized frame consumed by SDL_UpdateYUVTexture */
+    struct SwsContext *sws;
+    unsigned long hardware_frames;
+    unsigned int hw_errors;         /* decode errors before the first GPU frame; 3 => software */
+    unsigned int hw_corrupt;        /* corrupt GPU frames before the first clean one; LINUX_GPU_CORRUPT_BUDGET => software */
+    bool hardware_confirmed;
+#endif
+#ifdef LINUX_DMABUF
+    /* 0 = not tried yet, 1 = VA-API frames are presented zero-copy, -1 = unavailable here, so Feed()
+     * reads them back as before. Set by the UI thread, read by Feed(), both under `lock`. */
+    int dmabuf_state;
+    AVFrame *held[2];               /* the last two imported frames: GL may still be reading them */
+    unsigned long dmabuf_frames;
+#endif
+    Uint32 tex_format;              /* SDL_PIXELFORMAT_IYUV, or NV12 for an imported VA-API surface */
+    int pic_w, pic_h;              /* the picture inside the texture; a VA-API surface can be taller */
+};
+
+/* A player context only so Open() learns its SS4S_Player: the stats API is per player, and
+ * without it the Windows client could not show its own decode time (#32). Defined before
+ * Open(), which reads it. */
+struct SS4S_PlayerContext {
+    SS4S_Player *player;
+};
+
+static int Init(int argc, char *argv[]) {
+    (void) argc;
+    (void) argv;
+    /* This runs before SDL_INIT_VIDEO in the desktop app. Only core SDL primitives are
+     * created here; window/renderer use begins later through the host-render handoff. */
+    if (HostRenderProxy != NULL) {
+        return 0;
+    }
+    FFmpegHostRenderProxy *proxy = calloc(1, sizeof(*proxy));
+    if (proxy == NULL) {
+        return -1;
+    }
+    proxy->lock = SDL_CreateMutex();
+    if (proxy->lock == NULL) {
+        free(proxy);
+        return -1;
+    }
+    proxy->render.pending = host_pending;
+    proxy->render.draw = host_draw;
+    proxy->render.context = proxy;
+    proxy->render_thread_id = SDL_ThreadID();
+    HostRenderProxy = proxy;
+#ifdef _WIN32
+    WindowsCapabilitiesProbed = false;
+    WindowsHardwareCodecs = SS4S_VIDEO_NONE;
+#endif
+    return 0;
+}
+
+static void Quit(void) {
+    FFmpegHostRenderProxy *proxy = HostRenderProxy;
+    if (proxy == NULL) {
+        return;
+    }
+
+    /* SS4S_Quit runs after every player has closed and after the app UI has stopped polling.
+     * This is therefore the one point where both the published pointer and the proxy itself can
+     * go away. Clear the hint first so a later app-side lookup cannot acquire it. */
+    SDL_SetHintWithPriority(SS4S_HINT_HOST_RENDER, "", SDL_HINT_OVERRIDE);
+    SDL_LockMutex(proxy->lock);
+    proxy->instance = NULL;
+    /* app_deinit() tears the SDL renderer/window down before SS4S_Quit(). Any queued
+     * texture pointer is stale now and SDL already released the underlying resource.
+     * Free queue bookkeeping only; touching the SDL_Texture here would be a UAF. */
+    RetiredTexture *retired = proxy->retired_head;
+    while (retired != NULL) {
+        RetiredTexture *next = retired->next;
+        free(retired);
+        retired = next;
+    }
+    proxy->retired_head = proxy->retired_tail = NULL;
+    SDL_UnlockMutex(proxy->lock);
+    HostRenderProxy = NULL;
+    SDL_DestroyMutex(proxy->lock);
+    free(proxy);
+}
+
+static bool GetCapabilities(SS4S_VideoCapabilities *capabilities) {
+    memset(capabilities, 0, sizeof(*capabilities));
+    /* UI_COMPOSITING: the app's UI is drawn OVER this video, in the same window, by the
+     * same renderer. Saying so keeps the app from calling SS4S_PlayerVideoSetDisplayArea
+     * (there is no separate surface to place) and keeps it from closing its UI, which is
+     * what UI_EXCLUSIVE would mean and would leave nothing to render into. */
+    capabilities->transform = SS4S_VIDEO_CAP_TRANSFORM_UI_COMPOSITING;
+#ifdef _WIN32
+    /* Adapter-specific and fail-closed: do not make HEVC (or even H.264) visible in
+     * Settings until both FFmpeg and the selected physical D3D11 adapter prove it. */
+    capabilities->codecs = probe_windows_codecs();
+#else
+    capabilities->codecs = SS4S_VIDEO_H264 | SS4S_VIDEO_H265;
+#endif
+    /* Desktop game streams are Rec.709. Leaving this zero makes the session request
+     * Rec.601 while SDL treats HD IYUV as Rec.709, producing visibly wrong colour. */
+    capabilities->colorSpace = SS4S_VIDEO_CAP_COLORSPACE_BT709;
+    return capabilities->codecs != SS4S_VIDEO_NONE;
+}
+
+static enum AVCodecID codec_id_for(SS4S_VideoCodec codec) {
+    switch (codec) {
+        case SS4S_VIDEO_H264:
+            return AV_CODEC_ID_H264;
+        case SS4S_VIDEO_H265:
+            return AV_CODEC_ID_HEVC;
+        default:
+            return AV_CODEC_ID_NONE;
+    }
+}
+
+#ifdef _WIN32
+static const char *pixel_format_name(enum AVPixelFormat format) {
+    const char *name = av_get_pix_fmt_name(format);
+    return name != NULL ? name : "unknown";
+}
+
+/* Moonlight's ffGetFormat() deliberately returns AV_PIX_FMT_NONE rather than allowing
+ * FFmpeg to choose a software format when its selected accelerator is absent.  Do the
+ * same here: a Windows stream that logs D3D11VA must actually deliver D3D11 frames. */
+static enum AVPixelFormat windows_get_format(AVCodecContext *codec_ctx,
+                                              const enum AVPixelFormat *formats) {
+    SS4S_VideoInstance *inst = codec_ctx != NULL ? codec_ctx->opaque : NULL;
+    if (inst == NULL || formats == NULL) {
+        return AV_PIX_FMT_NONE;
+    }
+
+    if (inst->use_d3d11va) {
+        for (const enum AVPixelFormat *format = formats; *format != AV_PIX_FMT_NONE; format++) {
+            if (*format == inst->hw_pix_fmt) {
+                return *format;
+            }
+        }
+        LibContext->Log(SS4S_LogLevelError, "FFmpeg",
+                        "D3D11VA fail-closed gate: decoder did not offer required format %s",
+                        pixel_format_name(inst->hw_pix_fmt));
+        inst->fatal_decode_error = true;
+        return AV_PIX_FMT_NONE;
+    }
+
+    /* Reached only through the explicit diagnostic opt-in.  Never choose an accelerator
+     * here: the point of this mode is to isolate the software decoder for diagnosis. */
+    for (const enum AVPixelFormat *format = formats; *format != AV_PIX_FMT_NONE; format++) {
+        const AVPixFmtDescriptor *descriptor = av_pix_fmt_desc_get(*format);
+        if (descriptor != NULL && !(descriptor->flags & AV_PIX_FMT_FLAG_HWACCEL)) {
+            return *format;
+        }
+    }
+    return AV_PIX_FMT_NONE;
+}
+
+static const AVCodecHWConfig *find_d3d11va_config(const AVCodec *decoder) {
+    for (int index = 0;; index++) {
+        const AVCodecHWConfig *config = avcodec_get_hw_config(decoder, index);
+        if (config == NULL) {
+            return NULL;
+        }
+        if (config->device_type == AV_HWDEVICE_TYPE_D3D11VA &&
+                (config->methods & AV_CODEC_HW_CONFIG_METHOD_HW_DEVICE_CTX) != 0) {
+            return config;
+        }
+    }
+}
+
+static AVD3D11VADeviceContext *d3d11va_device_context(AVBufferRef *device_ref) {
+    if (device_ref == NULL || device_ref->data == NULL) {
+        return NULL;
+    }
+    AVHWDeviceContext *hw_device = (AVHWDeviceContext *) device_ref->data;
+    return (AVD3D11VADeviceContext *) hw_device->hwctx;
+}
+
+static bool validate_d3d11va_adapter(AVBufferRef *device_ref, char *adapter_description,
+                                     size_t adapter_description_size,
+                                     unsigned int *adapter_vendor,
+                                     unsigned int *adapter_device) {
+    if (adapter_description == NULL || adapter_description_size == 0 ||
+            adapter_vendor == NULL || adapter_device == NULL) {
+        return false;
+    }
+
+    AVD3D11VADeviceContext *d3d11 = d3d11va_device_context(device_ref);
+    if (d3d11 == NULL || d3d11->device == NULL) {
+        LibContext->Log(SS4S_LogLevelError, "FFmpeg",
+                        "D3D11VA fail-closed gate: hardware device has no ID3D11Device");
+        return false;
+    }
+
+    IDXGIDevice *dxgi_device = NULL;
+    IDXGIAdapter *base_adapter = NULL;
+    IDXGIAdapter1 *adapter = NULL;
+    bool valid = false;
+    HRESULT hr = ID3D11Device_QueryInterface(d3d11->device, &IID_IDXGIDevice,
+                                              (void **) &dxgi_device);
+    if (FAILED(hr) || dxgi_device == NULL) {
+        LibContext->Log(SS4S_LogLevelError, "FFmpeg",
+                        "D3D11VA fail-closed gate: ID3D11Device -> IDXGIDevice failed: 0x%08lx",
+                        (unsigned long) hr);
+        goto cleanup;
+    }
+    hr = IDXGIDevice_GetAdapter(dxgi_device, &base_adapter);
+    if (FAILED(hr) || base_adapter == NULL) {
+        LibContext->Log(SS4S_LogLevelError, "FFmpeg",
+                        "D3D11VA fail-closed gate: IDXGIDevice::GetAdapter failed: 0x%08lx",
+                        (unsigned long) hr);
+        goto cleanup;
+    }
+    hr = IDXGIAdapter_QueryInterface(base_adapter, &IID_IDXGIAdapter1, (void **) &adapter);
+    if (FAILED(hr) || adapter == NULL) {
+        LibContext->Log(SS4S_LogLevelError, "FFmpeg",
+                        "D3D11VA fail-closed gate: IDXGIAdapter1 query failed: 0x%08lx",
+                        (unsigned long) hr);
+        goto cleanup;
+    }
+
+    DXGI_ADAPTER_DESC1 description;
+    memset(&description, 0, sizeof(description));
+    hr = IDXGIAdapter1_GetDesc1(adapter, &description);
+    if (FAILED(hr)) {
+        LibContext->Log(SS4S_LogLevelError, "FFmpeg",
+                        "D3D11VA fail-closed gate: IDXGIAdapter1::GetDesc1 failed: 0x%08lx",
+                        (unsigned long) hr);
+        goto cleanup;
+    }
+    if ((description.Flags & (DXGI_ADAPTER_FLAG_SOFTWARE | DXGI_ADAPTER_FLAG_REMOTE)) != 0) {
+        LibContext->Log(SS4S_LogLevelError, "FFmpeg",
+                        "D3D11VA fail-closed gate: selected DXGI adapter is software/WARP "
+                        "or remote "
+                        "(vendor=0x%04x device=0x%04x flags=0x%x)",
+                        description.VendorId, description.DeviceId, description.Flags);
+        goto cleanup;
+    }
+
+    int converted = WideCharToMultiByte(CP_UTF8, 0, description.Description, -1,
+                                        adapter_description, (int) adapter_description_size,
+                                        NULL, NULL);
+    if (converted <= 0) {
+        snprintf(adapter_description, adapter_description_size, "unavailable");
+    }
+    *adapter_vendor = description.VendorId;
+    *adapter_device = description.DeviceId;
+    LibContext->Log(SS4S_LogLevelInfo, "FFmpeg",
+                    "D3D11VA HARDWARE ADAPTER: name=\"%s\" vendor=0x%04x device=0x%04x "
+                    "flags=0x%x",
+                    adapter_description, *adapter_vendor, *adapter_device, description.Flags);
+    valid = true;
+
+cleanup:
+    if (adapter != NULL) { IDXGIAdapter1_Release(adapter); }
+    if (base_adapter != NULL) { IDXGIAdapter_Release(base_adapter); }
+    if (dxgi_device != NULL) { IDXGIDevice_Release(dxgi_device); }
+    return valid;
+}
+
+static bool d3d11va_profile_format_supported(AVBufferRef *device_ref, const GUID *profile,
+                                             DXGI_FORMAT format, const char *codec_name) {
+    AVD3D11VADeviceContext *d3d11 = d3d11va_device_context(device_ref);
+    if (d3d11 == NULL || d3d11->device == NULL) {
+        return false;
+    }
+
+    ID3D11VideoDevice *video_device = NULL;
+    HRESULT hr = ID3D11Device_QueryInterface(d3d11->device, &IID_ID3D11VideoDevice,
+                                              (void **) &video_device);
+    if (FAILED(hr) || video_device == NULL) {
+        LibContext->Log(SS4S_LogLevelError, "FFmpeg",
+                        "D3D11VA %s capability query: ID3D11VideoDevice unavailable: 0x%08lx",
+                        codec_name, (unsigned long) hr);
+        return false;
+    }
+
+    bool profile_found = false;
+    const UINT profile_count = ID3D11VideoDevice_GetVideoDecoderProfileCount(video_device);
+    for (UINT index = 0; index < profile_count; index++) {
+        GUID candidate;
+        memset(&candidate, 0, sizeof(candidate));
+        hr = ID3D11VideoDevice_GetVideoDecoderProfile(video_device, index, &candidate);
+        if (SUCCEEDED(hr) && memcmp(&candidate, profile, sizeof(candidate)) == 0) {
+            profile_found = true;
+            break;
+        }
+    }
+
+    BOOL output_supported = FALSE;
+    if (profile_found) {
+        hr = ID3D11VideoDevice_CheckVideoDecoderFormat(video_device, profile, format,
+                                                       &output_supported);
+        if (FAILED(hr)) {
+            output_supported = FALSE;
+        }
+    }
+    ID3D11VideoDevice_Release(video_device);
+
+    LibContext->Log(profile_found && output_supported ? SS4S_LogLevelInfo : SS4S_LogLevelWarn,
+                    "FFmpeg", "D3D11VA %s capability: profile=%s output_format=%s",
+                    codec_name, profile_found ? "yes" : "no",
+                    output_supported ? "yes" : "no");
+    return profile_found && output_supported;
+}
+
+static bool d3d11va_codec_supported(AVBufferRef *device_ref, SS4S_VideoCodec codec) {
+    switch (codec) {
+        case SS4S_VIDEO_H264:
+            return d3d11va_profile_format_supported(device_ref,
+                                                    &D3D11_DECODER_PROFILE_H264_VLD_NOFGT,
+                                                    DXGI_FORMAT_NV12, "H.264/NV12");
+        case SS4S_VIDEO_H265:
+            return d3d11va_profile_format_supported(device_ref,
+                                                    &D3D11_DECODER_PROFILE_HEVC_VLD_MAIN,
+                                                    DXGI_FORMAT_NV12, "HEVC Main/NV12");
+        default:
+            return false;
+    }
+}
+
+static SS4S_VideoCodec probe_windows_codecs(void) {
+    if (WindowsCapabilitiesProbed) {
+        return WindowsHardwareCodecs;
+    }
+    WindowsCapabilitiesProbed = true;
+    WindowsHardwareCodecs = SS4S_VIDEO_NONE;
+
+    const char *diagnostic_decoder = SDL_getenv(DIAGNOSTIC_DECODER_ENV);
+    if (diagnostic_decoder != NULL && strcmp(diagnostic_decoder, "software") == 0) {
+        if (avcodec_find_decoder(AV_CODEC_ID_H264) != NULL) {
+            WindowsHardwareCodecs = (SS4S_VideoCodec) (WindowsHardwareCodecs | SS4S_VIDEO_H264);
+        }
+        if (avcodec_find_decoder(AV_CODEC_ID_HEVC) != NULL) {
+            WindowsHardwareCodecs = (SS4S_VideoCodec) (WindowsHardwareCodecs | SS4S_VIDEO_H265);
+        }
+        LibContext->Log(SS4S_LogLevelWarn, "FFmpeg",
+                        "Windows capabilities are software-only because %s=software; "
+                        "this run is NOT a valid functional test",
+                        DIAGNOSTIC_DECODER_ENV);
+        return WindowsHardwareCodecs;
+    }
+
+    AVBufferRef *device_ref = NULL;
+    const int err = av_hwdevice_ctx_create(&device_ref, AV_HWDEVICE_TYPE_D3D11VA,
+                                           NULL, NULL, 0);
+    if (err < 0 || device_ref == NULL) {
+        LibContext->Log(SS4S_LogLevelError, "FFmpeg",
+                        "D3D11VA capability gate: hardware device creation failed: %d", err);
+        av_buffer_unref(&device_ref);
+        return WindowsHardwareCodecs;
+    }
+
+    char adapter_description[384];
+    unsigned int adapter_vendor = 0;
+    unsigned int adapter_device = 0;
+    if (!validate_d3d11va_adapter(device_ref, adapter_description,
+                                  sizeof(adapter_description), &adapter_vendor,
+                                  &adapter_device)) {
+        av_buffer_unref(&device_ref);
+        return WindowsHardwareCodecs;
+    }
+
+    const AVCodec *h264 = avcodec_find_decoder(AV_CODEC_ID_H264);
+    if (h264 != NULL && find_d3d11va_config(h264) != NULL &&
+            d3d11va_codec_supported(device_ref, SS4S_VIDEO_H264)) {
+        WindowsHardwareCodecs = (SS4S_VideoCodec) (WindowsHardwareCodecs | SS4S_VIDEO_H264);
+    }
+    const AVCodec *hevc = avcodec_find_decoder(AV_CODEC_ID_HEVC);
+    if (hevc != NULL && find_d3d11va_config(hevc) != NULL &&
+            d3d11va_codec_supported(device_ref, SS4S_VIDEO_H265)) {
+        WindowsHardwareCodecs = (SS4S_VideoCodec) (WindowsHardwareCodecs | SS4S_VIDEO_H265);
+    }
+
+    LibContext->Log(WindowsHardwareCodecs != SS4S_VIDEO_NONE ? SS4S_LogLevelInfo :
+                                                               SS4S_LogLevelError,
+                    "FFmpeg", "D3D11VA advertised codecs on \"%s\": H.264=%s HEVC=%s",
+                    adapter_description,
+                    (WindowsHardwareCodecs & SS4S_VIDEO_H264) ? "yes" : "no",
+                    (WindowsHardwareCodecs & SS4S_VIDEO_H265) ? "yes" : "no");
+    av_buffer_unref(&device_ref);
+    return WindowsHardwareCodecs;
+}
+#endif
+
+static void instance_free(SS4S_VideoInstance *instance) {
+    if (instance == NULL) {
+        return;
+    }
+    /* SDL textures are retired by Close() and destroyed by host_draw() on the UI thread.
+     * Never call SDL_DestroyTexture() from this stream-thread cleanup helper. */
+    if (instance->texture != NULL && LibContext != NULL) {
+        LibContext->Log(SS4S_LogLevelError, "FFmpeg",
+                        "Texture reached instance_free without UI-thread retirement; "
+                        "leaving it for SDL renderer teardown");
+    }
+    if (instance->shared != NULL) { av_frame_free(&instance->shared); }
+    if (instance->frame != NULL) { av_frame_free(&instance->frame); }
+    if (instance->packet != NULL) { av_packet_free(&instance->packet); }
+    if (instance->codec_ctx != NULL) { avcodec_free_context(&instance->codec_ctx); }
+#ifdef _WIN32
+    if (instance->download != NULL) { av_frame_free(&instance->download); }
+    if (instance->i420 != NULL) { av_frame_free(&instance->i420); }
+    if (instance->sws != NULL) { sws_freeContext(instance->sws); }
+    av_buffer_unref(&instance->hw_device_ctx);
+#endif
+#ifdef LINUX_HWACCEL
+    if (instance->download != NULL) { av_frame_free(&instance->download); }
+    if (instance->i420 != NULL) { av_frame_free(&instance->i420); }
+    if (instance->sws != NULL) { sws_freeContext(instance->sws); }
+#ifdef LINUX_DMABUF
+    av_frame_free(&instance->held[0]);
+    av_frame_free(&instance->held[1]);
+#endif
+    av_buffer_unref(&instance->hw_device_ctx);
+#endif
+    if (instance->lock != NULL) { SDL_DestroyMutex(instance->lock); }
+    free(instance);
+}
+
+#ifdef LINUX_HWACCEL
+/* LINUX GPU DECODE. NVDEC first: the VA-API shim on NVIDIA cannot hand frames back to the
+ * CPU, while CUDA device creation fails fast (no libcuda) everywhere else. Then VA-API for
+ * Intel and AMD. ECLIPSE_DIAGNOSTIC_VIDEO_DECODER=software|nvdec|vaapi pins one path. */
+static const struct {
+    enum AVHWDeviceType type;
+    const char *name;
+} LinuxHwBackends[] = {
+        {AV_HWDEVICE_TYPE_CUDA,  "nvdec"},
+        {AV_HWDEVICE_TYPE_VAAPI, "vaapi"},
+};
+
+static const char *linux_pix_fmt_name(enum AVPixelFormat format) {
+    const char *name = av_get_pix_fmt_name(format);
+    return name != NULL ? name : "unknown";
+}
+
+static void linux_set_software(SS4S_VideoInstance *inst) {
+    SDL_LockMutex(inst->lock);
+    inst->hw_pix_fmt = AV_PIX_FMT_NONE;
+    inst->hw_path = "software";
+    SDL_UnlockMutex(inst->lock);
+}
+
+/* Take the armed GPU format when the decoder offers it. Otherwise -- the driver lacks this
+ * profile, or FFmpeg's hwaccel init failed and it is asking again without it -- pick a
+ * software format; returning NONE, as Windows does, would end the stream. */
+static enum AVPixelFormat linux_get_format(AVCodecContext *codec_ctx, const enum AVPixelFormat *formats) {
+    SS4S_VideoInstance *inst = codec_ctx != NULL ? codec_ctx->opaque : NULL;
+    if (inst == NULL || formats == NULL) {
+        return AV_PIX_FMT_NONE;
+    }
+    if (inst->hw_pix_fmt != AV_PIX_FMT_NONE) {
+        for (const enum AVPixelFormat *format = formats; *format != AV_PIX_FMT_NONE; format++) {
+            if (*format == inst->hw_pix_fmt) {
+                return *format;
+            }
+        }
+        LibContext->Log(SS4S_LogLevelWarn, "FFmpeg", "%s did not offer %s for this stream; decoding in software",
+                        inst->hw_path, linux_pix_fmt_name(inst->hw_pix_fmt));
+        linux_set_software(inst);
+    }
+    for (const enum AVPixelFormat *format = formats; *format != AV_PIX_FMT_NONE; format++) {
+        const AVPixFmtDescriptor *descriptor = av_pix_fmt_desc_get(*format);
+        if (descriptor != NULL && !(descriptor->flags & AV_PIX_FMT_FLAG_HWACCEL)) {
+            return *format;
+        }
+    }
+    return AV_PIX_FMT_NONE;
+}
+
+/* Arm the first GPU backend whose device opens. Nothing is decoded yet: the first frame
+ * proves the path (linux_present_frame), and failures before it fall back to software. */
+static void linux_open_hwaccel(SS4S_VideoInstance *inst, const AVCodec *decoder) {
+    inst->hw_pix_fmt = AV_PIX_FMT_NONE;
+    inst->hw_path = "software";
+    inst->codec_ctx->opaque = inst;
+    inst->codec_ctx->get_format = linux_get_format;
+    const char *pinned = SDL_getenv(DIAGNOSTIC_DECODER_ENV);
+    if (pinned != NULL && pinned[0] == '\0') {
+        pinned = NULL;
+    }
+    if (pinned != NULL && strcmp(pinned, "software") == 0) {
+        LibContext->Log(SS4S_LogLevelWarn, "FFmpeg", "Software decode pinned by %s=software",
+                        DIAGNOSTIC_DECODER_ENV);
+        return;
+    }
+    for (size_t i = 0; i < sizeof(LinuxHwBackends) / sizeof(LinuxHwBackends[0]); i++) {
+        if (pinned != NULL && strcmp(pinned, LinuxHwBackends[i].name) != 0) {
+            continue;
+        }
+        const AVCodecHWConfig *config = NULL;
+        for (int index = 0; (config = avcodec_get_hw_config(decoder, index)) != NULL; index++) {
+            if (config->device_type == LinuxHwBackends[i].type &&
+                    (config->methods & AV_CODEC_HW_CONFIG_METHOD_HW_DEVICE_CTX) != 0) {
+                break;
+            }
+        }
+        if (config == NULL) {
+            continue;
+        }
+        const int err = av_hwdevice_ctx_create(&inst->hw_device_ctx, LinuxHwBackends[i].type, NULL, NULL, 0);
+        if (err < 0 || inst->hw_device_ctx == NULL) {
+            LibContext->Log(SS4S_LogLevelInfo, "FFmpeg", "%s unavailable (device creation: %d)",
+                            LinuxHwBackends[i].name, err);
+            av_buffer_unref(&inst->hw_device_ctx);
+            continue;
+        }
+        inst->codec_ctx->hw_device_ctx = av_buffer_ref(inst->hw_device_ctx);
+        if (inst->codec_ctx->hw_device_ctx == NULL) {
+            av_buffer_unref(&inst->hw_device_ctx);
+            continue;
+        }
+#ifdef LINUX_DMABUF
+        if (LinuxHwBackends[i].type == AV_HWDEVICE_TYPE_VAAPI) {
+            /* VA-API surfaces come from a fixed pool sized for the decoder alone. Zero-copy keeps up to
+             * three of them out of it: the frame waiting for the UI thread and the two in `held`. */
+            inst->codec_ctx->extra_hw_frames = 3;
+        }
+#endif
+        inst->hw_pix_fmt = config->pix_fmt;
+        inst->hw_path = LinuxHwBackends[i].name;
+        LibContext->Log(SS4S_LogLevelInfo, "FFmpeg",
+                        "%s device ready for %s (frame format %s); waiting for the first GPU frame",
+                        inst->hw_path, decoder->name, linux_pix_fmt_name(inst->hw_pix_fmt));
+        return;
+    }
+    LibContext->Log(pinned != NULL ? SS4S_LogLevelWarn : SS4S_LogLevelInfo, "FFmpeg",
+                    "No GPU decoder %s; decoding in software",
+                    pinned != NULL ? "matches the pinned value" : "is available");
+}
+
+/* The armed GPU path failed before proving itself, or its readback broke: rebuild the decoder
+ * in software (same settings as Open) so the caller's keyframe request restarts the picture. */
+static bool linux_fallback_to_software(SS4S_VideoInstance *inst, const char *why) {
+    LibContext->Log(SS4S_LogLevelWarn, "FFmpeg", "%s failed (%s); reopening the decoder in software",
+                    inst->hw_path, why);
+    const AVCodec *decoder = inst->codec_ctx->codec;
+    AVCodecContext *ctx = decoder != NULL ? avcodec_alloc_context3(decoder) : NULL;
+    if (ctx == NULL) {
+        return false;
+    }
+    ctx->width = inst->codec_ctx->width;
+    ctx->height = inst->codec_ctx->height;
+    ctx->flags = inst->codec_ctx->flags;
+    ctx->flags2 = inst->codec_ctx->flags2;
+    ctx->err_recognition = inst->codec_ctx->err_recognition;
+    ctx->thread_type = FF_THREAD_SLICE;
+    ctx->opaque = inst;
+    ctx->get_format = linux_get_format;
+    linux_set_software(inst);
+    if (avcodec_open2(ctx, decoder, NULL) < 0) {
+        avcodec_free_context(&ctx);
+        return false;
+    }
+    avcodec_free_context(&inst->codec_ctx);
+    inst->codec_ctx = ctx;
+    av_buffer_unref(&inst->hw_device_ctx);
+    return true;
+}
+
+/* ~5 s at 60 fps of corrupt-only GPU frames: far longer than a co-op start or a loss takes to clear. */
+#define LINUX_GPU_CORRUPT_BUDGET 300
+
+/* A decode error while a GPU path is armed but unproven: the third one falls back. */
+static void linux_note_gpu_error(SS4S_VideoInstance *inst, const char *what) {
+    if (inst->hw_pix_fmt != AV_PIX_FMT_NONE && !inst->hardware_confirmed && ++inst->hw_errors >= 3) {
+        linux_fallback_to_software(inst, what);
+    }
+}
+
+/* GPU frame -> CPU -> IYUV, as normalize_windows_frame() does for D3D11VA. Returns the frame
+ * to present: `decoded` itself when it is already a CPU frame in the renderer's layout. */
+static AVFrame *linux_present_frame(SS4S_VideoInstance *inst, AVFrame *decoded) {
+    AVFrame *cpu_frame = decoded;
+#ifdef LINUX_DMABUF
+    if (decoded->format == AV_PIX_FMT_VAAPI) {
+        /* The UI thread imports the surface itself (host_import_dmabuf): nothing to do here, which is
+         * the point -- this runs on the receive thread. Only once that import has failed does a VA-API
+         * frame fall through to the readback below. */
+        SDL_LockMutex(inst->lock);
+        const bool zero_copy = inst->dmabuf_state >= 0;
+        if (zero_copy) {
+            inst->hardware_frames++;
+            inst->hardware_confirmed = true;
+        }
+        SDL_UnlockMutex(inst->lock);
+        if (zero_copy) {
+            return decoded;
+        }
+    }
+#endif
+    if (decoded->hw_frames_ctx != NULL) {
+        av_frame_unref(inst->download);
+        const int err = av_hwframe_transfer_data(inst->download, decoded, 0);
+        if (err < 0) {
+            LibContext->Log(SS4S_LogLevelError, "FFmpeg", "%s GPU->CPU frame transfer failed: %d",
+                            inst->hw_path, err);
+            return NULL;
+        }
+        cpu_frame = inst->download;
+        SDL_LockMutex(inst->lock);
+        inst->hardware_frames++;
+        const bool first_hardware_frame = !inst->hardware_confirmed;
+        inst->hardware_confirmed = true;
+        SDL_UnlockMutex(inst->lock);
+        if (first_hardware_frame) {
+            LibContext->Log(SS4S_LogLevelInfo, "FFmpeg", "%s ACTIVE: GPU decode confirmed, readback format %s",
+                            inst->hw_path, linux_pix_fmt_name((enum AVPixelFormat) cpu_frame->format));
+        }
+    }
+    if (cpu_frame->format == AV_PIX_FMT_YUV420P || cpu_frame->format == AV_PIX_FMT_YUVJ420P) {
+        return cpu_frame;
+    }
+    if (cpu_frame->width <= 0 || cpu_frame->height <= 0 || cpu_frame->data[0] == NULL) {
+        LibContext->Log(SS4S_LogLevelError, "FFmpeg", "Decoded frame has invalid CPU layout: format=%s size=%dx%d",
+                        linux_pix_fmt_name((enum AVPixelFormat) cpu_frame->format),
+                        cpu_frame->width, cpu_frame->height);
+        return NULL;
+    }
+    int err;
+    if (inst->i420->format != AV_PIX_FMT_YUV420P || inst->i420->width != cpu_frame->width ||
+            inst->i420->height != cpu_frame->height || inst->i420->data[0] == NULL) {
+        av_frame_unref(inst->i420);
+        inst->i420->format = AV_PIX_FMT_YUV420P;
+        inst->i420->width = cpu_frame->width;
+        inst->i420->height = cpu_frame->height;
+        err = av_frame_get_buffer(inst->i420, 32);
+    } else {
+        err = av_frame_make_writable(inst->i420);
+    }
+    if (err < 0) {
+        LibContext->Log(SS4S_LogLevelError, "FFmpeg", "Unable to prepare the IYUV presentation frame: %d", err);
+        return NULL;
+    }
+    inst->sws = sws_getCachedContext(inst->sws,
+                                     cpu_frame->width, cpu_frame->height, cpu_frame->format,
+                                     cpu_frame->width, cpu_frame->height, AV_PIX_FMT_YUV420P,
+                                     SWS_FAST_BILINEAR, NULL, NULL, NULL);
+    if (inst->sws == NULL ||
+            sws_scale(inst->sws, (const uint8_t *const *) cpu_frame->data, cpu_frame->linesize, 0,
+                      cpu_frame->height, inst->i420->data, inst->i420->linesize) != cpu_frame->height) {
+        LibContext->Log(SS4S_LogLevelError, "FFmpeg", "%s -> yuv420p presentation conversion failed",
+                        linux_pix_fmt_name((enum AVPixelFormat) cpu_frame->format));
+        return NULL;
+    }
+    return inst->i420;
+}
+#endif
+
+static SS4S_VideoOpenResult Open(const SS4S_VideoInfo *info, const SS4S_VideoExtraInfo *extraInfo,
+                                 SS4S_VideoInstance **instance, SS4S_PlayerContext *context) {
+    (void) extraInfo;
+
+    const enum AVCodecID id = codec_id_for(info->codec);
+    if (id == AV_CODEC_ID_NONE) {
+        LibContext->Log(SS4S_LogLevelError, "FFmpeg", "Unsupported codec %d", (int) info->codec);
+        return SS4S_VIDEO_OPEN_UNSUPPORTED_CODEC;
+    }
+
+    /* The app's window, published before any module loaded. Without it there is nothing to
+     * draw into and no honest way to continue: creating one here is the failure this module
+     * was rewritten to remove. */
+    SDL_Window *window = NULL;
+    const char *window_hint = SDL_GetHint(SS4S_HINT_HOST_WINDOW);
+    if (window_hint != NULL) {
+        sscanf(window_hint, "%p", (void **) &window);
+    }
+    if (window == NULL) {
+        LibContext->Log(SS4S_LogLevelError, "FFmpeg", "No host window published (%s)",
+                        SS4S_HINT_HOST_WINDOW);
+        return SS4S_VIDEO_OPEN_ERROR;
+    }
+    SDL_Renderer *renderer = SDL_GetRenderer(window);
+    if (renderer == NULL) {
+        LibContext->Log(SS4S_LogLevelError, "FFmpeg", "Host window has no renderer: %s", SDL_GetError());
+        return SS4S_VIDEO_OPEN_ERROR;
+    }
+
+    SS4S_VideoInstance *inst = calloc(1, sizeof(SS4S_VideoInstance));
+    if (inst == NULL) {
+        return SS4S_VIDEO_OPEN_ERROR;
+    }
+    inst->renderer = renderer;
+    inst->player = context != NULL ? context->player : NULL;
+
+    const AVCodec *decoder = avcodec_find_decoder(id);
+    if (decoder == NULL) {
+        LibContext->Log(SS4S_LogLevelError, "FFmpeg", "No decoder for %s",
+                        SS4S_VideoCodecName(info->codec));
+        instance_free(inst);
+        return SS4S_VIDEO_OPEN_UNSUPPORTED_CODEC;
+    }
+    inst->codec_ctx = avcodec_alloc_context3(decoder);
+    if (inst->codec_ctx == NULL) {
+        instance_free(inst);
+        return SS4S_VIDEO_OPEN_ERROR;
+    }
+    inst->codec_ctx->width = info->width;
+    inst->codec_ctx->height = info->height;
+    /* Low latency, as the native client asks for: no frame reordering and every thread on
+     * the picture rather than pipelined across frames. */
+    inst->codec_ctx->flags |= AV_CODEC_FLAG_LOW_DELAY | AV_CODEC_FLAG_OUTPUT_CORRUPT;
+    inst->codec_ctx->flags2 |= AV_CODEC_FLAG2_SHOW_ALL;
+    /* Match Moonlight Qt: HEVC hwaccel start_frame failures can otherwise be dropped
+     * without an error, leaving persistent corruption for an infinite-GOP stream. */
+    inst->codec_ctx->err_recognition = AV_EF_EXPLODE;
+#ifdef _WIN32
+    const char *diagnostic_decoder = SDL_getenv(DIAGNOSTIC_DECODER_ENV);
+    const bool diagnostic_software = diagnostic_decoder != NULL &&
+                                     strcmp(diagnostic_decoder, "software") == 0;
+    if (diagnostic_decoder != NULL && diagnostic_decoder[0] != '\0' && !diagnostic_software) {
+        LibContext->Log(SS4S_LogLevelWarn, "FFmpeg",
+                        "Ignoring invalid %s=%s (the only accepted value is 'software'); "
+                        "D3D11VA remains mandatory",
+                        DIAGNOSTIC_DECODER_ENV, diagnostic_decoder);
+    }
+
+    inst->codec_ctx->opaque = inst;
+    inst->codec_ctx->get_format = windows_get_format;
+    inst->hw_pix_fmt = AV_PIX_FMT_NONE;
+    if (diagnostic_software) {
+        LibContext->Log(SS4S_LogLevelWarn, "FFmpeg",
+                        "DIAGNOSTIC SOFTWARE DECODER ENABLED by %s=software; "
+                        "this run is NOT a valid Windows functional test",
+                        DIAGNOSTIC_DECODER_ENV);
+        inst->codec_ctx->thread_type = FF_THREAD_SLICE;
+    } else {
+        const AVCodecHWConfig *hw_config = find_d3d11va_config(decoder);
+        if (hw_config == NULL) {
+            LibContext->Log(SS4S_LogLevelError, "FFmpeg",
+                            "D3D11VA fail-closed gate: %s decoder exposes no D3D11VA "
+                            "HW_DEVICE_CTX configuration",
+                            decoder->name);
+            instance_free(inst);
+            return SS4S_VIDEO_OPEN_ERROR;
+        }
+        inst->hw_pix_fmt = hw_config->pix_fmt;
+        int hw_err = av_hwdevice_ctx_create(&inst->hw_device_ctx, AV_HWDEVICE_TYPE_D3D11VA,
+                                            NULL, NULL, 0);
+        if (hw_err < 0 || inst->hw_device_ctx == NULL) {
+            LibContext->Log(SS4S_LogLevelError, "FFmpeg",
+                            "D3D11VA fail-closed gate: av_hwdevice_ctx_create failed: %d; "
+                            "software fallback is disabled",
+                            hw_err);
+            instance_free(inst);
+            return SS4S_VIDEO_OPEN_ERROR;
+        }
+        if (!validate_d3d11va_adapter(inst->hw_device_ctx, inst->adapter_description,
+                                      sizeof(inst->adapter_description),
+                                      &inst->adapter_vendor, &inst->adapter_device)) {
+            instance_free(inst);
+            return SS4S_VIDEO_OPEN_ERROR;
+        }
+        if (!d3d11va_codec_supported(inst->hw_device_ctx, info->codec)) {
+            LibContext->Log(SS4S_LogLevelError, "FFmpeg",
+                            "D3D11VA fail-closed gate: selected physical adapter does not "
+                            "support %s in the required output format",
+                            SS4S_VideoCodecName(info->codec));
+            instance_free(inst);
+            return SS4S_VIDEO_OPEN_ERROR;
+        }
+        inst->codec_ctx->hw_device_ctx = av_buffer_ref(inst->hw_device_ctx);
+        if (inst->codec_ctx->hw_device_ctx == NULL) {
+            LibContext->Log(SS4S_LogLevelError, "FFmpeg",
+                            "D3D11VA fail-closed gate: unable to retain hardware device");
+            instance_free(inst);
+            return SS4S_VIDEO_OPEN_ERROR;
+        }
+        inst->use_d3d11va = true;
+        inst->codec_ctx->thread_count = 1;
+        LibContext->Log(SS4S_LogLevelInfo, "FFmpeg",
+                        "D3D11VA REQUIRED: device initialized for %s (expected frame format %s); "
+                        "waiting for the first decoded hardware frame",
+                        decoder->name, pixel_format_name(inst->hw_pix_fmt));
+    }
+#else
+    inst->codec_ctx->thread_type = FF_THREAD_SLICE;
+#ifdef LINUX_HWACCEL
+    linux_open_hwaccel(inst, decoder);
+#endif
+#endif
+    if (avcodec_open2(inst->codec_ctx, decoder, NULL) < 0) {
+        LibContext->Log(SS4S_LogLevelError, "FFmpeg", "avcodec_open2 failed");
+        instance_free(inst);
+        return SS4S_VIDEO_OPEN_ERROR;
+    }
+
+    inst->packet = av_packet_alloc();
+    inst->frame = av_frame_alloc();
+    inst->shared = av_frame_alloc();
+    inst->lock = SDL_CreateMutex();
+#if defined(_WIN32) || defined(LINUX_HWACCEL)
+    inst->download = av_frame_alloc();
+    inst->i420 = av_frame_alloc();
+#endif
+    if (inst->packet == NULL || inst->frame == NULL || inst->shared == NULL || inst->lock == NULL
+#if defined(_WIN32) || defined(LINUX_HWACCEL)
+            || inst->download == NULL || inst->i420 == NULL
+#endif
+    ) {
+        instance_free(inst);
+        return SS4S_VIDEO_OPEN_ERROR;
+    }
+
+    FFmpegHostRenderProxy *proxy = HostRenderProxy;
+    if (proxy == NULL) {
+        instance_free(inst);
+        return SS4S_VIDEO_OPEN_ERROR;
+    }
+    SDL_LockMutex(proxy->lock);
+    proxy->instance = inst;
+    SDL_UnlockMutex(proxy->lock);
+    char buf[32];
+    snprintf(buf, sizeof(buf), "%p", (void *) &proxy->render);
+    if (!SDL_SetHintWithPriority(SS4S_HINT_HOST_RENDER, buf, SDL_HINT_OVERRIDE)) {
+        SDL_LockMutex(proxy->lock);
+        if (proxy->instance == inst) {
+            proxy->instance = NULL;
+        }
+        SDL_UnlockMutex(proxy->lock);
+        instance_free(inst);
+        return SS4S_VIDEO_OPEN_ERROR;
+    }
+
+    LibContext->Log(SS4S_LogLevelInfo, "FFmpeg",
+#ifdef _WIN32
+                    "Opened %s decoder at %dx%d (path=%s), drawing into host window",
+                    SS4S_VideoCodecName(info->codec), info->width, info->height,
+                    inst->use_d3d11va ? "d3d11va-required" : "software-diagnostic");
+#elif defined(LINUX_HWACCEL)
+                    "Opened %s decoder at %dx%d (path=%s), drawing into host window",
+                    SS4S_VideoCodecName(info->codec), info->width, info->height, inst->hw_path);
+#else
+                    "Opened %s decoder at %dx%d, drawing into host window",
+                    SS4S_VideoCodecName(info->codec), info->width, info->height);
+#endif
+    *instance = inst;
+    return SS4S_VIDEO_OPEN_OK;
+}
+
+static bool ensure_texture(SS4S_VideoInstance *inst, int w, int h, Uint32 format) {
+    if (inst->texture != NULL && inst->tex_w == w && inst->tex_h == h && inst->tex_format == format) {
+        return true;
+    }
+    if (inst->texture != NULL) {
+        SDL_DestroyTexture(inst->texture);
+        inst->texture = NULL;
+    }
+    /* IYUV because the presentation boundary is AV_PIX_FMT_YUV420P -- directly from the
+     * decoder on other platforms, or normalized after D3D11VA readback on Windows. NV12 only
+     * for an imported VA-API surface, whose planes replace the texture's own storage. */
+    SDL_SetYUVConversionMode(SDL_YUV_CONVERSION_BT709);
+    if (format == SDL_PIXELFORMAT_NV12) {
+        /* SDL 2.32 stores NV12's chroma as LUMINANCE_ALPHA and samples .ra unless this is set; an
+         * imported GR88 plane needs .rg (SDL_render_gl.c GL_CreateTexture, read at creation;
+         * SDL_render_gles2.c, read per draw). Only this module creates NV12 textures. */
+        SDL_SetHint("SDL_RENDER_OPENGL_NV12_RG_SHADER", "1");
+    }
+    inst->texture = SDL_CreateTexture(inst->renderer, format,
+                                      format == SDL_PIXELFORMAT_NV12 ? SDL_TEXTUREACCESS_STATIC :
+                                                                       SDL_TEXTUREACCESS_STREAMING, w, h);
+    if (inst->texture == NULL) {
+        LibContext->Log(SS4S_LogLevelError, "FFmpeg", "SDL_CreateTexture failed: %s", SDL_GetError());
+        return false;
+    }
+    inst->tex_w = w;
+    inst->tex_h = h;
+    inst->tex_format = format;
+    return true;
+}
+
+#ifdef LINUX_DMABUF
+#define DMABUF_DRM_FORMAT_R8 0x20203852u            /* fourcc 'R','8',' ',' ' (drm_fourcc.h) */
+#define DMABUF_DRM_FORMAT_GR88 0x38385247u          /* fourcc 'G','R','8','8' */
+#define DMABUF_DRM_FORMAT_MOD_INVALID 0x00ffffffffffffffULL
+
+/* What the import needs from EGL and GL, resolved once on the UI thread with SDL's context current. */
+static struct {
+    int state;                      /* 0 = not resolved, 1 = usable, -1 = not here (`why`) */
+    const char *why;
+    EGLDisplay display;
+    bool modifiers;                 /* EGL_EXT_image_dma_buf_import_modifiers */
+    PFNEGLCREATEIMAGEKHRPROC CreateImage;
+    PFNEGLDESTROYIMAGEKHRPROC DestroyImage;
+    void (APIENTRY *ImageTargetTexture2D)(GLenum target, void *image);
+    void (APIENTRY *ActiveTexture)(GLenum texture);
+    void (APIENTRY *GetIntegerv)(GLenum name, GLint *value);
+    GLenum (APIENTRY *GetError)(void);
+} DmabufApi;
+
+static bool has_token(const char *list, const char *token) {
+    const size_t n = strlen(token);
+    for (const char *p = list; p != NULL && (p = strstr(p, token)) != NULL; p += n) {
+        if ((p == list || p[-1] == ' ') && (p[n] == ' ' || p[n] == '\0')) {
+            return true;
+        }
+    }
+    return false;
+}
+
+/* Called with SDL's GL context current. A GLX context (X11 without EGL) has no libEGL loaded: no import. */
+static bool dmabuf_api_ready(void) {
+    if (DmabufApi.state != 0) {
+        return DmabufApi.state > 0;
+    }
+    DmabufApi.state = -1;
+    void *egl = dlopen("libEGL.so.1", RTLD_LAZY | RTLD_NOLOAD);
+    EGLDisplay (*get_current_display)(void) = egl != NULL ? (EGLDisplay (*)(void)) dlsym(egl, "eglGetCurrentDisplay") : NULL;
+    const char *(*query_string)(EGLDisplay, EGLint) =
+            egl != NULL ? (const char *(*)(EGLDisplay, EGLint)) dlsym(egl, "eglQueryString") : NULL;
+    void *(*get_proc)(const char *) = egl != NULL ? (void *(*)(const char *)) dlsym(egl, "eglGetProcAddress") : NULL;
+    if (get_current_display == NULL || query_string == NULL || get_proc == NULL) {
+        DmabufApi.why = "no EGL in this process (a GLX context)";
+        return false;
+    }
+    DmabufApi.display = get_current_display();
+    const char *extensions = DmabufApi.display != EGL_NO_DISPLAY ? query_string(DmabufApi.display, EGL_EXTENSIONS) : NULL;
+    if (extensions == NULL) {
+        DmabufApi.why = "SDL's GL context is not an EGL context";
+        return false;
+    }
+    if (!has_token(extensions, "EGL_EXT_image_dma_buf_import")) {
+        DmabufApi.why = "EGL_EXT_image_dma_buf_import missing";
+        return false;
+    }
+    DmabufApi.modifiers = has_token(extensions, "EGL_EXT_image_dma_buf_import_modifiers");
+    DmabufApi.CreateImage = (PFNEGLCREATEIMAGEKHRPROC) get_proc("eglCreateImageKHR");
+    DmabufApi.DestroyImage = (PFNEGLDESTROYIMAGEKHRPROC) get_proc("eglDestroyImageKHR");
+    DmabufApi.ImageTargetTexture2D = SDL_GL_GetProcAddress("glEGLImageTargetTexture2DOES");
+    DmabufApi.ActiveTexture = SDL_GL_GetProcAddress("glActiveTexture");
+    DmabufApi.GetIntegerv = SDL_GL_GetProcAddress("glGetIntegerv");
+    DmabufApi.GetError = SDL_GL_GetProcAddress("glGetError");
+    if (DmabufApi.CreateImage == NULL || DmabufApi.DestroyImage == NULL || DmabufApi.ActiveTexture == NULL ||
+            DmabufApi.GetIntegerv == NULL || DmabufApi.GetError == NULL) {
+        DmabufApi.why = "EGL/GL entry points missing";
+        return false;
+    }
+    if (DmabufApi.ImageTargetTexture2D == NULL || !SDL_GL_ExtensionSupported("GL_OES_EGL_image")) {
+        DmabufApi.why = "GL_OES_EGL_image missing";
+        return false;
+    }
+    DmabufApi.state = 1;
+    return true;
+}
+
+/* One exported layer (a single plane) as an EGLImage. */
+static EGLImageKHR dmabuf_layer_image(const VADRMPRIMESurfaceDescriptor *desc, int layer, int w, int h) {
+    const uint32_t object = desc->layers[layer].object_index[0];
+    const uint64_t modifier = desc->objects[object].drm_format_modifier;
+    EGLint attribs[20];
+    int n = 0;
+    attribs[n++] = EGL_WIDTH;
+    attribs[n++] = w;
+    attribs[n++] = EGL_HEIGHT;
+    attribs[n++] = h;
+    attribs[n++] = EGL_LINUX_DRM_FOURCC_EXT;
+    attribs[n++] = (EGLint) desc->layers[layer].drm_format;
+    attribs[n++] = EGL_DMA_BUF_PLANE0_FD_EXT;
+    attribs[n++] = desc->objects[object].fd;
+    attribs[n++] = EGL_DMA_BUF_PLANE0_OFFSET_EXT;
+    attribs[n++] = (EGLint) desc->layers[layer].offset[0];
+    attribs[n++] = EGL_DMA_BUF_PLANE0_PITCH_EXT;
+    attribs[n++] = (EGLint) desc->layers[layer].pitch[0];
+    if (modifier != DMABUF_DRM_FORMAT_MOD_INVALID) {
+        if (!DmabufApi.modifiers) {
+            /* Without the modifiers extension EGL assumes a linear layout: a tiled surface would come out
+             * scrambled, so refuse it (0 = DRM_FORMAT_MOD_LINEAR is the one layout it can take). */
+            if (modifier != 0) {
+                return EGL_NO_IMAGE_KHR;
+            }
+        } else {
+            attribs[n++] = EGL_DMA_BUF_PLANE0_MODIFIER_LO_EXT;
+            attribs[n++] = (EGLint) (modifier & 0xffffffffu);
+            attribs[n++] = EGL_DMA_BUF_PLANE0_MODIFIER_HI_EXT;
+            attribs[n++] = (EGLint) (modifier >> 32);
+        }
+    }
+    attribs[n] = EGL_NONE;
+    return DmabufApi.CreateImage(DmabufApi.display, EGL_NO_CONTEXT, EGL_LINUX_DMA_BUF_EXT, NULL, attribs);
+}
+
+/* UI thread. Present a VA-API frame without touching its pixels: export the surface's two planes as
+ * DMA-BUFs, make them the storage of an SDL NV12 texture's Y and UV textures, and keep the frame alive
+ * while GL may read it. Takes ownership of `frame`. Any failure turns zero-copy off for this stream;
+ * Feed() then reads frames back as before, and this one frame is not drawn. */
+static void host_import_dmabuf(SS4S_VideoInstance *inst, AVFrame *frame) {
+    if (inst->dmabuf_state < 0) {
+        av_frame_free(&frame);      /* published by Feed() just before the switch; the next is a CPU frame */
+        return;
+    }
+    const char *why = NULL;
+    const AVHWFramesContext *frames = (const AVHWFramesContext *) frame->hw_frames_ctx->data;
+    const AVVAAPIDeviceContext *va = frames->device_ctx->hwctx;
+    const VASurfaceID surface = (VASurfaceID) (uintptr_t) frame->data[3];
+    VADRMPRIMESurfaceDescriptor desc;
+    bool exported = false;
+    EGLImageKHR images[2] = {EGL_NO_IMAGE_KHR, EGL_NO_IMAGE_KHR};
+
+    if (vaSyncSurface(va->display, surface) != VA_STATUS_SUCCESS) {
+        why = "vaSyncSurface failed";
+    } else if (vaExportSurfaceHandle(va->display, surface, VA_SURFACE_ATTRIB_MEM_TYPE_DRM_PRIME_2,
+                                     VA_EXPORT_SURFACE_READ_ONLY | VA_EXPORT_SURFACE_SEPARATE_LAYERS,
+                                     &desc) != VA_STATUS_SUCCESS) {
+        why = "vaExportSurfaceHandle failed";
+    } else {
+        exported = true;
+        if (desc.num_layers != 2 || desc.layers[0].drm_format != DMABUF_DRM_FORMAT_R8 ||
+                desc.layers[1].drm_format != DMABUF_DRM_FORMAT_GR88) {
+            why = "the surface is not 8-bit NV12";
+        } else if (!ensure_texture(inst, (int) desc.width, (int) desc.height, SDL_PIXELFORMAT_NV12)) {
+            why = "no SDL NV12 texture";
+        } else if (SDL_GL_BindTexture(inst->texture, NULL, NULL) != 0) {
+            why = "SDL_GL_BindTexture failed (not a GL renderer)";
+        } else {
+            /* Bound: Y on GL_TEXTURE0, UV on GL_TEXTURE1 (SDL_render_gl.c / SDL_render_gles2.c BindTexture). */
+            GLint bound = 0;
+            if (dmabuf_api_ready()) {
+                DmabufApi.GetIntegerv(GL_TEXTURE_BINDING_2D, &bound);
+            }
+            if (DmabufApi.state < 0) {
+                why = DmabufApi.why;
+            } else if (bound == 0) {
+                why = "SDL's texture is not a GL_TEXTURE_2D";
+            } else {
+                images[0] = dmabuf_layer_image(&desc, 0, (int) desc.width, (int) desc.height);
+                images[1] = dmabuf_layer_image(&desc, 1, ((int) desc.width + 1) / 2, ((int) desc.height + 1) / 2);
+                if (images[0] == EGL_NO_IMAGE_KHR || images[1] == EGL_NO_IMAGE_KHR) {
+                    why = "eglCreateImageKHR failed";
+                } else {
+                    while (DmabufApi.GetError() != GL_NO_ERROR) {}
+                    DmabufApi.ImageTargetTexture2D(GL_TEXTURE_2D, images[0]);
+                    DmabufApi.ActiveTexture(GL_TEXTURE1);
+                    DmabufApi.ImageTargetTexture2D(GL_TEXTURE_2D, images[1]);
+                    DmabufApi.ActiveTexture(GL_TEXTURE0);
+                    if (DmabufApi.GetError() != GL_NO_ERROR) {
+                        why = "glEGLImageTargetTexture2DOES failed";
+                    }
+                }
+            }
+            SDL_GL_UnbindTexture(inst->texture);
+        }
+    }
+    /* The textures keep the buffers; the images and descriptors are not needed past this point. */
+    for (int i = 0; i < 2; i++) {
+        if (images[i] != EGL_NO_IMAGE_KHR) {
+            DmabufApi.DestroyImage(DmabufApi.display, images[i]);
+        }
+    }
+    if (exported) {
+        for (uint32_t i = 0; i < desc.num_objects; i++) {
+            close(desc.objects[i].fd);
+        }
+    }
+
+    SDL_LockMutex(inst->lock);
+    const bool first = why == NULL && inst->dmabuf_state == 0;
+    inst->dmabuf_state = why == NULL ? 1 : -1;
+    if (why == NULL) {
+        inst->dmabuf_frames++;
+    }
+    SDL_UnlockMutex(inst->lock);
+    if (why != NULL) {
+        av_frame_free(&frame);
+        if (inst->texture != NULL && inst->tex_format == SDL_PIXELFORMAT_NV12) {
+            SDL_DestroyTexture(inst->texture);   /* half-imported; the readback path makes an IYUV one */
+            inst->texture = NULL;
+        }
+        LibContext->Log(SS4S_LogLevelWarn, "FFmpeg", "vaapi zero-copy unavailable (%s); reading frames back instead",
+                        why);
+        return;
+    }
+    if (first) {
+        LibContext->Log(SS4S_LogLevelInfo, "FFmpeg",
+                        "vaapi ACTIVE: GPU decode confirmed, presenting zero-copy (DMA-BUF %ux%u, modifier 0x%llx)",
+                        desc.width, desc.height,
+                        (unsigned long long) desc.objects[desc.layers[0].object_index[0]].drm_format_modifier);
+    }
+    av_frame_free(&inst->held[1]);
+    inst->held[1] = inst->held[0];
+    inst->held[0] = frame;
+    inst->pic_w = frame->width;
+    inst->pic_h = frame->height;
+    inst->mean_luma = -1;           /* not measured: reading the pixels is what this path avoids */
+}
+#endif
+
+static bool host_pending(void *context) {
+    FFmpegHostRenderProxy *proxy = context;
+    if (proxy == NULL || proxy->lock == NULL || SDL_LockMutex(proxy->lock) != 0) {
+        return false;
+    }
+    SS4S_VideoInstance *inst = proxy->instance;
+    bool pending = proxy->retired_head != NULL;
+    if (inst != NULL) {
+        SDL_LockMutex(inst->lock);
+        pending = pending || inst->has_new;
+        SDL_UnlockMutex(inst->lock);
+    }
+    SDL_UnlockMutex(proxy->lock);
+    return pending;
+}
+
+/* Main thread. Uploads the newest frame if there is one, then draws whatever the texture
+ * holds -- redrawing the last frame is correct and cheap when the app repaints for its own
+ * reasons (a menu opening) between two arrivals. */
+static bool host_draw(void *context) {
+    FFmpegHostRenderProxy *proxy = context;
+    if (proxy == NULL || proxy->lock == NULL || SDL_LockMutex(proxy->lock) != 0) {
+        return false;
+    }
+    if (SDL_ThreadID() != proxy->render_thread_id) {
+        LibContext->Log(SS4S_LogLevelError, "FFmpeg",
+                        "Refusing host_draw outside the SDL UI thread");
+        SDL_UnlockMutex(proxy->lock);
+        return false;
+    }
+
+    /* Close() transfers textures here instead of destroying them on the stream worker.
+     * Drain the whole list first so rapid reconnects cannot strand an older texture. */
+    while (proxy->retired_head != NULL) {
+        RetiredTexture *retired = proxy->retired_head;
+        proxy->retired_head = retired->next;
+        if (proxy->retired_head == NULL) {
+            proxy->retired_tail = NULL;
+        }
+        SDL_DestroyTexture(retired->texture);
+        free(retired);
+    }
+
+    SS4S_VideoInstance *inst = proxy->instance;
+    if (inst == NULL) {
+        SDL_UnlockMutex(proxy->lock);
+        return false;
+    }
+    unsigned long fed_snapshot;
+    unsigned long decoded_snapshot;
+    unsigned long corrupt_frames_snapshot;
+    unsigned int last_corrupt_frame_flags_snapshot;
+    unsigned int last_decode_error_flags_snapshot;
+#ifdef _WIN32
+    unsigned long hardware_frames_snapshot;
+    unsigned long readbacks_snapshot;
+    unsigned long i420_conversions_snapshot;
+    bool hardware_confirmed_snapshot;
+#endif
+#ifdef LINUX_HWACCEL
+    const char *hw_path_snapshot;
+    unsigned long hardware_frames_snapshot;
+#endif
+#ifdef LINUX_DMABUF
+    AVFrame *gpu_frame = NULL;
+#endif
+    SDL_LockMutex(inst->lock);
+#ifdef LINUX_DMABUF
+    if (inst->has_new && inst->shared->format == AV_PIX_FMT_VAAPI) {
+        /* Taken out under the lock, imported after it: Feed() on the receive thread never waits for GL. */
+        gpu_frame = av_frame_alloc();
+        if (gpu_frame != NULL) {
+            av_frame_move_ref(gpu_frame, inst->shared);
+        } else {
+            av_frame_unref(inst->shared);
+        }
+        inst->has_new = false;
+    }
+#endif
+    if (inst->has_new && inst->shared->data[0] != NULL) {
+        if (ensure_texture(inst, inst->shared->width, inst->shared->height, SDL_PIXELFORMAT_IYUV)) {
+            SDL_UpdateYUVTexture(inst->texture, NULL,
+                                 inst->shared->data[0], inst->shared->linesize[0],
+                                 inst->shared->data[1], inst->shared->linesize[1],
+                                 inst->shared->data[2], inst->shared->linesize[2]);
+            inst->pic_w = inst->shared->width;
+            inst->pic_h = inst->shared->height;
+        }
+        /* Mean luma of the frame we just uploaded. A black window is either a black
+         * SOURCE -- which is what a fullscreen client on the machine it is streaming FROM
+         * captures, its own empty window -- or a picture that something drew over. The
+         * counters cannot tell those apart and this can. */
+        if (inst->drawn % 600 == 0) {
+            unsigned long sum = 0, n = 0;
+            for (int y = 0; y < inst->shared->height; y += 16) {
+                const uint8_t *row = inst->shared->data[0] + (size_t) y * inst->shared->linesize[0];
+                for (int x = 0; x < inst->shared->width; x += 16) { sum += row[x]; n++; }
+            }
+            inst->mean_luma = n ? (int) (sum / n) : -1;
+        }
+        inst->has_new = false;
+        /* The SDL texture owns the uploaded pixels now. Releasing this reference promptly
+         * lets the decoder or IYUV normalization buffer be reused instead of allocating a
+         * fresh full-resolution buffer for every frame. */
+        av_frame_unref(inst->shared);
+    }
+    /* Feed() owns these counters on the stream thread. Snapshot them under the same
+     * mutex as their writes; "diagnostic only" does not make a C data race benign. */
+    fed_snapshot = inst->fed;
+    decoded_snapshot = inst->decoded;
+    corrupt_frames_snapshot = inst->corrupt_frames;
+    last_corrupt_frame_flags_snapshot = inst->last_corrupt_frame_flags;
+    last_decode_error_flags_snapshot = inst->last_decode_error_flags;
+#ifdef _WIN32
+    hardware_frames_snapshot = inst->hardware_frames;
+    readbacks_snapshot = inst->readbacks;
+    i420_conversions_snapshot = inst->i420_conversions;
+    hardware_confirmed_snapshot = inst->hardware_confirmed;
+#endif
+#ifdef LINUX_HWACCEL
+    hw_path_snapshot = inst->hw_path;
+    hardware_frames_snapshot = inst->hardware_frames;
+#endif
+    SDL_UnlockMutex(inst->lock);
+#ifdef LINUX_DMABUF
+    if (gpu_frame != NULL) {
+        host_import_dmabuf(inst, gpu_frame);
+    }
+#endif
+
+    if (inst->texture == NULL) {
+        SDL_UnlockMutex(proxy->lock);
+        return false;
+    }
+    /* One line every ~10s of a 60fps stream. It is the cheapest thing that distinguishes
+     * the three ways this can look broken while the connection looks healthy: nothing fed,
+     * fed but not decoding, decoding but never drawn -- plus meanY for a picture that is
+     * simply black at the source. */
+    if (++inst->drawn % 600 == 1) {
+#ifdef _WIN32
+        LibContext->Log(SS4S_LogLevelInfo, "FFmpeg",
+                        "path=%s fed=%lu decoded=%lu hw_frames=%lu readbacks=%lu "
+                        "i420_conversions=%lu corrupt=%lu last=0x%x/0x%x "
+                        "drawn=%lu tex=%dx%d meanY=%d",
+                        inst->use_d3d11va ?
+                                (hardware_confirmed_snapshot ? "d3d11va-active" :
+                                                               "d3d11va-pending") :
+                                "software-diagnostic",
+                        fed_snapshot, decoded_snapshot, hardware_frames_snapshot,
+                        readbacks_snapshot, i420_conversions_snapshot, corrupt_frames_snapshot,
+                        last_corrupt_frame_flags_snapshot, last_decode_error_flags_snapshot,
+                        inst->drawn, inst->tex_w, inst->tex_h, inst->mean_luma);
+#elif defined(LINUX_HWACCEL)
+        /* present=dmabuf: VA-API frames reached the screen without a readback, and dmabuf counts them.
+         * Both are written on this thread only (host_import_dmabuf). */
+#ifdef LINUX_DMABUF
+        const char *present = inst->dmabuf_state > 0 ? "dmabuf" : "copy";
+        const unsigned long dmabuf_frames = inst->dmabuf_frames;
+#else
+        const char *present = "copy";
+        const unsigned long dmabuf_frames = 0;
+#endif
+        LibContext->Log(SS4S_LogLevelInfo, "FFmpeg",
+                        "path=%s present=%s fed=%lu decoded=%lu hw_frames=%lu dmabuf=%lu corrupt=%lu "
+                        "last=0x%x/0x%x drawn=%lu tex=%dx%d meanY=%d",
+                        hw_path_snapshot, present, fed_snapshot, decoded_snapshot, hardware_frames_snapshot,
+                        dmabuf_frames, corrupt_frames_snapshot, last_corrupt_frame_flags_snapshot,
+                        last_decode_error_flags_snapshot, inst->drawn, inst->tex_w, inst->tex_h,
+                        inst->mean_luma);
+#else
+        LibContext->Log(SS4S_LogLevelInfo, "FFmpeg",
+                        "fed=%lu decoded=%lu corrupt=%lu last=0x%x/0x%x "
+                        "drawn=%lu tex=%dx%d meanY=%d",
+                        fed_snapshot, decoded_snapshot, corrupt_frames_snapshot,
+                        last_corrupt_frame_flags_snapshot, last_decode_error_flags_snapshot,
+                        inst->drawn, inst->tex_w, inst->tex_h, inst->mean_luma);
+#endif
+    }
+    /* Letterbox rather than stretch: the stream's aspect is the host's, the window's is the
+     * user's, and they are not the same once the window is resized. */
+    int win_w = 0, win_h = 0;
+    if (SDL_GetRendererOutputSize(inst->renderer, &win_w, &win_h) != 0 || win_w <= 0 || win_h <= 0) {
+        SDL_UnlockMutex(proxy->lock);
+        return false;
+    }
+    /* The picture, not the texture: an imported VA-API surface can be taller than the frame. */
+    const SDL_Rect src = {0, 0, inst->pic_w > 0 ? inst->pic_w : inst->tex_w, inst->pic_h > 0 ? inst->pic_h : inst->tex_h};
+    SDL_Rect dst;
+    const int scaled_h = src.h * win_w / src.w;
+    if (scaled_h <= win_h) {
+        dst.w = win_w;
+        dst.h = scaled_h;
+    } else {
+        dst.w = src.w * win_h / src.h;
+        dst.h = win_h;
+    }
+    dst.x = (win_w - dst.w) / 2;
+    dst.y = (win_h - dst.h) / 2;
+
+    SDL_SetRenderDrawColor(inst->renderer, 0, 0, 0, 0xFF);
+    SDL_RenderClear(inst->renderer);
+    SDL_RenderCopy(inst->renderer, inst->texture, &src, &dst);
+    SDL_UnlockMutex(proxy->lock);
+    return true;
+}
+
+#ifdef _WIN32
+/* Turn a D3D11VA download (normally NV12, or P010 for 10-bit HEVC) into the planar
+ * 8-bit layout consumed by the existing SDL IYUV renderer. This is intentionally a
+ * presentation conversion only: avcodec_receive_frame() has already completed on the
+ * D3D11VA hardware path, and the counters/logs keep that distinction observable. */
+static AVFrame *normalize_windows_frame(SS4S_VideoInstance *instance, AVFrame *decoded) {
+    AVFrame *cpu_frame = decoded;
+
+    if (instance->use_d3d11va) {
+        if (decoded->format != instance->hw_pix_fmt || decoded->hw_frames_ctx == NULL) {
+            LibContext->Log(SS4S_LogLevelError, "FFmpeg",
+                            "D3D11VA fail-closed gate: received %s frame without a hardware "
+                            "frames context (expected %s)",
+                            pixel_format_name((enum AVPixelFormat) decoded->format),
+                            pixel_format_name(instance->hw_pix_fmt));
+            instance->fatal_decode_error = true;
+            return NULL;
+        }
+
+        av_frame_unref(instance->download);
+        int err = av_hwframe_transfer_data(instance->download, decoded, 0);
+        if (err < 0) {
+            LibContext->Log(SS4S_LogLevelError, "FFmpeg",
+                            "D3D11VA fail-closed gate: GPU->CPU frame transfer failed: %d", err);
+            instance->fatal_decode_error = true;
+            return NULL;
+        }
+        cpu_frame = instance->download;
+
+        SDL_LockMutex(instance->lock);
+        instance->hardware_frames++;
+        instance->readbacks++;
+        const bool first_hardware_frame = !instance->hardware_confirmed;
+        instance->hardware_confirmed = true;
+        SDL_UnlockMutex(instance->lock);
+
+        if (first_hardware_frame) {
+            LibContext->Log(SS4S_LogLevelInfo, "FFmpeg",
+                            "D3D11VA ACTIVE: received hardware format %s with hw_frames_ctx; "
+                            "GPU decode confirmed on \"%s\" (vendor=0x%04x device=0x%04x), "
+                            "readback format=%s",
+                            pixel_format_name(instance->hw_pix_fmt),
+                            instance->adapter_description, instance->adapter_vendor,
+                            instance->adapter_device,
+                            pixel_format_name((enum AVPixelFormat) cpu_frame->format));
+        }
+    }
+
+    if (cpu_frame->width <= 0 || cpu_frame->height <= 0 || cpu_frame->data[0] == NULL) {
+        LibContext->Log(SS4S_LogLevelError, "FFmpeg",
+                        "Decoded frame has invalid CPU layout: format=%s size=%dx%d",
+                        pixel_format_name((enum AVPixelFormat) cpu_frame->format),
+                        cpu_frame->width, cpu_frame->height);
+        instance->fatal_decode_error = instance->use_d3d11va;
+        return NULL;
+    }
+    if (cpu_frame->format == AV_PIX_FMT_YUV420P) {
+        return cpu_frame;
+    }
+
+    if (instance->i420->format != AV_PIX_FMT_YUV420P ||
+            instance->i420->width != cpu_frame->width ||
+            instance->i420->height != cpu_frame->height || instance->i420->data[0] == NULL) {
+        av_frame_unref(instance->i420);
+        instance->i420->format = AV_PIX_FMT_YUV420P;
+        instance->i420->width = cpu_frame->width;
+        instance->i420->height = cpu_frame->height;
+        int err = av_frame_get_buffer(instance->i420, 32);
+        if (err < 0) {
+            LibContext->Log(SS4S_LogLevelError, "FFmpeg",
+                            "Unable to allocate IYUV presentation frame: %d", err);
+            instance->fatal_decode_error = instance->use_d3d11va;
+            return NULL;
+        }
+    } else {
+        int err = av_frame_make_writable(instance->i420);
+        if (err < 0) {
+            LibContext->Log(SS4S_LogLevelError, "FFmpeg",
+                            "Unable to make IYUV presentation frame writable: %d", err);
+            instance->fatal_decode_error = instance->use_d3d11va;
+            return NULL;
+        }
+    }
+
+    instance->sws = sws_getCachedContext(instance->sws,
+                                         cpu_frame->width, cpu_frame->height, cpu_frame->format,
+                                         cpu_frame->width, cpu_frame->height, AV_PIX_FMT_YUV420P,
+                                         SWS_FAST_BILINEAR, NULL, NULL, NULL);
+    if (instance->sws == NULL) {
+        LibContext->Log(SS4S_LogLevelError, "FFmpeg",
+                        "Unable to create %s -> yuv420p presentation conversion",
+                        pixel_format_name((enum AVPixelFormat) cpu_frame->format));
+        instance->fatal_decode_error = instance->use_d3d11va;
+        return NULL;
+    }
+    const int rows = sws_scale(instance->sws,
+                               (const uint8_t *const *) cpu_frame->data, cpu_frame->linesize,
+                               0, cpu_frame->height,
+                               instance->i420->data, instance->i420->linesize);
+    if (rows != cpu_frame->height) {
+        LibContext->Log(SS4S_LogLevelError, "FFmpeg",
+                        "%s -> yuv420p presentation conversion returned %d/%d rows",
+                        pixel_format_name((enum AVPixelFormat) cpu_frame->format), rows,
+                        cpu_frame->height);
+        instance->fatal_decode_error = instance->use_d3d11va;
+        return NULL;
+    }
+    SDL_LockMutex(instance->lock);
+    instance->i420_conversions++;
+    SDL_UnlockMutex(instance->lock);
+    return instance->i420;
+}
+#endif
+
+static SS4S_VideoFeedResult Feed(SS4S_VideoInstance *instance, const unsigned char *data, size_t size,
+                                 SS4S_VideoFeedFlags flags) {
+    if (instance == NULL || instance->codec_ctx == NULL) {
+        return SS4S_VIDEO_FEED_ERROR;
+    }
+#ifdef _WIN32
+    if (instance->fatal_decode_error) {
+        return SS4S_VIDEO_FEED_ERROR;
+    }
+#endif
+    if (size > INT_MAX) {
+        return SS4S_VIDEO_FEED_ERROR;
+    }
+    /* FFmpeg bit readers may inspect AV_INPUT_BUFFER_PADDING_SIZE bytes beyond the packet.
+     * The SS4S caller owns and immediately reuses its buffer, and co-op can hand us one of
+     * several independently allocated rewrite buffers, so there is no single caller-side
+     * allocation that can safely promise this contract. Own one padded AVPacket here instead.
+     * av_new_packet() allocates the required tail; zero it explicitly so damaged streams
+     * cannot turn an optimized over-read into undefined behavior. */
+    av_packet_unref(instance->packet);
+    if (av_new_packet(instance->packet, (int) size) < 0) {
+        LibContext->Log(SS4S_LogLevelError, "FFmpeg", "av_new_packet(%llu) failed",
+                        (unsigned long long) size);
+        return SS4S_VIDEO_FEED_ERROR;
+    }
+    memcpy(instance->packet->data, data, size);
+    memset(instance->packet->data + size, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+    /* Preserve the caller's access-unit identity at the libavcodec boundary. Moonlight's
+     * native FFmpeg path sets this exact flag; dropping it here made an SS4S keyframe
+     * indistinguishable from an ordinary packet to decoder integrations that consult it. */
+    instance->packet->flags = (flags & SS4S_VIDEO_FEED_DATA_KEYFRAME) != 0 ? AV_PKT_FLAG_KEY : 0;
+    SDL_LockMutex(instance->lock);
+    instance->fed++;
+    SDL_UnlockMutex(instance->lock);
+
+    /* Decoder latency (#32): from here to the frame being ready for the UI thread to draw --
+     * decode, and on Windows the D3D11VA readback + I420 normalization too. */
+    bool stats_open = instance->player != NULL;
+    const uint32_t stats_begin = stats_open ? LibContext->VideoStats.BeginFrame(instance->player) : 0;
+
+    int err = avcodec_send_packet(instance->codec_ctx, instance->packet);
+    if (err < 0) {
+        LibContext->Log(SS4S_LogLevelWarn, "FFmpeg", "avcodec_send_packet: %d", err);
+        av_packet_unref(instance->packet);
+#ifdef _WIN32
+        if (instance->fatal_decode_error) {
+            return SS4S_VIDEO_FEED_ERROR;
+        }
+#endif
+#ifdef LINUX_HWACCEL
+        linux_note_gpu_error(instance, "avcodec_send_packet");
+#endif
+        return SS4S_VIDEO_FEED_REQUEST_KEYFRAME;
+    }
+    av_packet_unref(instance->packet);
+    while ((err = avcodec_receive_frame(instance->codec_ctx, instance->frame)) == 0) {
+        /* OUTPUT_CORRUPT is enabled so libavcodec may return a frame despite a missing
+         * reference or another decode fault. A successful receive is therefore not by itself
+         * a healthy frame. Do not publish damaged pixels; translate libavcodec's existing signal
+         * into SS4S's existing keyframe request so the poisoned reference chain is re-anchored. */
+        const unsigned int frame_flags = (unsigned int) instance->frame->flags;
+        const unsigned int decode_error_flags =
+                (unsigned int) instance->frame->decode_error_flags;
+        if ((frame_flags & AV_FRAME_FLAG_CORRUPT) != 0 || decode_error_flags != 0) {
+            SDL_LockMutex(instance->lock);
+            instance->corrupt_frames++;
+            instance->last_corrupt_frame_flags = frame_flags;
+            instance->last_decode_error_flags = decode_error_flags;
+            SDL_UnlockMutex(instance->lock);
+            LibContext->Log(SS4S_LogLevelWarn, "FFmpeg",
+                            "Discarding corrupt decoded frame: flags=0x%x decode_errors=0x%x",
+                            frame_flags, decode_error_flags);
+#ifdef LINUX_HWACCEL
+            const bool gpu_frame = instance->frame->hw_frames_ctx != NULL;
+#endif
+            av_frame_unref(instance->frame);
+#ifdef LINUX_HWACCEL
+            /* A corrupt frame the GPU RETURNED is a decoder that works and lacks a reference (a co-op
+             * composite before both panes' keyframes, a lost packet). Counted as one of the three GPU
+             * errors, every co-op start that began with three of them moved the 3840x2176 composite to
+             * software decoding on the receive thread: 34 fps, PC2's socket overflowing, keyframe pumping
+             * (VEGA 2026-10-23, docs L16). Only a GPU that returns nothing BUT corrupt frames gives up. */
+            if (!gpu_frame) {
+                linux_note_gpu_error(instance, "corrupt frames");
+            } else if (instance->hw_pix_fmt != AV_PIX_FMT_NONE && !instance->hardware_confirmed &&
+                       ++instance->hw_corrupt >= LINUX_GPU_CORRUPT_BUDGET) {
+                linux_fallback_to_software(instance, "only corrupt frames");
+            }
+#endif
+            return SS4S_VIDEO_FEED_REQUEST_KEYFRAME;
+        }
+        /* Hand the frame over by reference, not by copy: move_ref leaves `frame` clean for
+         * the next receive and the app's thread reads the buffer the decoder already owns. */
+#ifdef _WIN32
+        AVFrame *presented = normalize_windows_frame(instance, instance->frame);
+        if (presented == NULL) {
+            av_frame_unref(instance->frame);
+            return instance->fatal_decode_error ? SS4S_VIDEO_FEED_ERROR :
+                                                  SS4S_VIDEO_FEED_REQUEST_KEYFRAME;
+        }
+        SDL_LockMutex(instance->lock);
+        av_frame_unref(instance->shared);
+        int ref_err = av_frame_ref(instance->shared, presented);
+        if (ref_err >= 0) {
+            instance->has_new = true;
+            instance->decoded++;
+        }
+        SDL_UnlockMutex(instance->lock);
+        av_frame_unref(instance->frame);
+        if (ref_err >= 0 && stats_open) {
+            LibContext->VideoStats.EndFrame(instance->player, stats_begin);
+            stats_open = false;
+        }
+        if (ref_err < 0) {
+            LibContext->Log(SS4S_LogLevelError, "FFmpeg",
+                            "Unable to retain decoded presentation frame: %d", ref_err);
+            return SS4S_VIDEO_FEED_ERROR;
+        }
+#elif defined(LINUX_HWACCEL)
+        AVFrame *presented = linux_present_frame(instance, instance->frame);
+        if (presented == NULL) {
+            av_frame_unref(instance->frame);
+            if (instance->hw_pix_fmt != AV_PIX_FMT_NONE && !linux_fallback_to_software(instance, "frame readback")) {
+                return SS4S_VIDEO_FEED_ERROR;
+            }
+            return SS4S_VIDEO_FEED_REQUEST_KEYFRAME;
+        }
+        SDL_LockMutex(instance->lock);
+        av_frame_unref(instance->shared);
+        int ref_err = 0;
+        if (presented == instance->frame) {
+            av_frame_move_ref(instance->shared, instance->frame);   /* software frame: as before */
+        } else {
+            ref_err = av_frame_ref(instance->shared, presented);
+        }
+        if (ref_err >= 0) {
+            instance->has_new = true;
+            instance->decoded++;
+        }
+        SDL_UnlockMutex(instance->lock);
+        av_frame_unref(instance->frame);
+        if (ref_err < 0) {
+            LibContext->Log(SS4S_LogLevelError, "FFmpeg", "Unable to retain decoded presentation frame: %d", ref_err);
+            return SS4S_VIDEO_FEED_ERROR;
+        }
+        if (stats_open) {
+            LibContext->VideoStats.EndFrame(instance->player, stats_begin);
+            stats_open = false;
+        }
+#else
+        SDL_LockMutex(instance->lock);
+        av_frame_unref(instance->shared);
+        av_frame_move_ref(instance->shared, instance->frame);
+        instance->has_new = true;
+        instance->decoded++;
+        SDL_UnlockMutex(instance->lock);
+        if (stats_open) {
+            LibContext->VideoStats.EndFrame(instance->player, stats_begin);
+            stats_open = false;
+        }
+#endif
+    }
+    if (err != AVERROR(EAGAIN) && err != AVERROR_EOF) {
+        LibContext->Log(SS4S_LogLevelWarn, "FFmpeg", "avcodec_receive_frame: %d", err);
+#ifdef _WIN32
+        if (instance->fatal_decode_error) {
+            return SS4S_VIDEO_FEED_ERROR;
+        }
+#endif
+#ifdef LINUX_HWACCEL
+        linux_note_gpu_error(instance, "avcodec_receive_frame");
+#endif
+        return SS4S_VIDEO_FEED_REQUEST_KEYFRAME;
+    }
+    return SS4S_VIDEO_FEED_OK;
+}
+
+static bool SizeChanged(SS4S_VideoInstance *instance, int width, int height) {
+    /* The texture follows the DECODED frame size, so nothing to do until one arrives. */
+    (void) instance;
+    (void) width;
+    (void) height;
+    return true;
+}
+
+static bool SetHDRInfo(SS4S_VideoInstance *instance, const SS4S_VideoHDRInfo *info) {
+    /* The presentation boundary is 8-bit IYUV (including after D3D11VA readback): there
+     * is nowhere to put HDR metadata, and claiming otherwise would make the host send a
+     * picture this interim renderer cannot present correctly. */
+    (void) instance;
+    (void) info;
+    return false;
+}
+
+static void Close(SS4S_VideoInstance *instance) {
+    FFmpegHostRenderProxy *proxy = HostRenderProxy;
+    if (proxy != NULL) {
+        SDL_LockMutex(proxy->lock);
+        if (proxy->instance == instance) {
+            proxy->instance = NULL;
+        }
+        if (instance->texture != NULL) {
+            if (SDL_ThreadID() == proxy->render_thread_id) {
+                SDL_DestroyTexture(instance->texture);
+                instance->texture = NULL;
+            } else {
+                RetiredTexture *retired = calloc(1, sizeof(*retired));
+                if (retired != NULL) {
+                    retired->texture = instance->texture;
+                    instance->texture = NULL;
+                    if (proxy->retired_tail != NULL) {
+                        proxy->retired_tail->next = retired;
+                    } else {
+                        proxy->retired_head = retired;
+                    }
+                    proxy->retired_tail = retired;
+                    /* Ownership transfer is the synchronization boundary. Never wait here:
+                     * app shutdown joins this worker on the UI thread, so waiting for a draw
+                     * would deadlock. The unconditional pending poll drains the queue while
+                     * the UI runs; renderer teardown owns the last-resort release. */
+                    LibContext->Log(SS4S_LogLevelInfo, "FFmpeg",
+                                    "SDL texture queued for UI-thread retirement");
+                } else {
+                    LibContext->Log(SS4S_LogLevelError, "FFmpeg",
+                                    "Unable to queue SDL texture for UI-thread retirement; "
+                                    "leaving it for SDL renderer teardown");
+                }
+            }
+        }
+        SDL_UnlockMutex(proxy->lock);
+    }
+    instance_free(instance);
+}
+
+static SS4S_PlayerContext *PlayerCreate(SS4S_Player *player) {
+    SS4S_PlayerContext *context = calloc(1, sizeof(SS4S_PlayerContext));
+    if (context != NULL) {
+        context->player = player;
+    }
+    return context;
+}
+
+static void PlayerDestroy(SS4S_PlayerContext *context) {
+    free(context);
+}
+
+static const SS4S_PlayerDriver FFmpegPlayerDriver = {
+        .Create = PlayerCreate,
+        .Destroy = PlayerDestroy,
+};
+
+static const SS4S_VideoDriver FFmpegDriver = {
+        .Base = {
+                .Init = Init,
+                .Quit = Quit,
+        },
+        .GetCapabilities = GetCapabilities,
+        .Open = Open,
+        .Feed = Feed,
+        .SizeChanged = SizeChanged,
+        /* No SetDisplayArea: claiming UI_COMPOSITING means the app never calls it. */
+        .SetHDRInfo = SetHDRInfo,
+        .Close = Close,
+};
+
+SS4S_EXPORTED bool SS4S_ModuleOpen_FFMPEG(SS4S_Module *module, const SS4S_LibraryContext *context) {
+    module->Name = "ffmpeg";
+    module->PlayerDriver = &FFmpegPlayerDriver;
+    module->VideoDriver = &FFmpegDriver;
+    LibContext = context;
+    return true;
+}
