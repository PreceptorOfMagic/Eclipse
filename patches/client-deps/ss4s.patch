index 0000000000000000000000000000000000000000..c281e96c6709620b274e5881498a9250286ffb8c
--- /dev/null
+++ b/tests/test_audio_clock_capability.c
@@ -0,0 +1,28 @@
+/* Uses the actual library selector and optional-symbol loader, no player/device. */
+#include <assert.h>
+#include <stdio.h>
+#include "ss4s.h"
+static void SilentLog(SS4S_LogLevel level, const char *tag, const char *fmt, ...) {
+    (void) level; (void) tag; (void) fmt;
+}
+int main(void) {
+    assert(!SS4S_AudioHasClock() && !SS4S_AudioHasPull());
+    SS4S_Config config = {.audioDriver = "legacy-fixture", .loggingFunction = SilentLog};
+    assert(SS4S_Init(0, NULL, &config) == 0);
+    assert(!SS4S_AudioHasClock() && !SS4S_AudioHasPull());
+    SS4S_Quit();
+    config.audioDriver = "clock-fixture";
+    assert(SS4S_Init(0, NULL, &config) == 0);
+    assert(SS4S_AudioHasClock() && SS4S_AudioHasPull()); /* No audio instance exists. */
+    SS4S_AudioClock clock;
+    assert(!SS4S_PlayerAudioGetClock(NULL, &clock));
+    assert(clock.sample_rate == 0 && clock.generation == 0);
+    SS4S_Quit();
+    assert(!SS4S_AudioHasClock() && !SS4S_AudioHasPull());
+    config.audioDriver = "legacy-fixture";
+    assert(SS4S_Init(0, NULL, &config) == 0);
+    assert(!SS4S_AudioHasClock() && !SS4S_AudioHasPull());
+    SS4S_Quit();
+    puts("PASS capability: old module false, new module true before open, instance still validated, quit/reselection clears capability");
+    return 0;
+}
diff --git a/tests/test_audio_clock_core.c b/tests/test_audio_clock_core.c
new file mode 100644
index 0000000000000000000000000000000000000000..51f6d981a7fd5db137c80be4031093e64cf69080
--- /dev/null
+++ b/tests/test_audio_clock_core.c
@@ -0,0 +1,105 @@
+#include <assert.h>
+#include <stdio.h>
+#include <SDL2/SDL.h>
+#include "ss4s.h"
+#include "library.h"
+#include "lib_logging.h"
+
+static SDL_sem *query_entered, *query_release;
+static SDL_atomic_t close_calls;
+static bool supported = true, block_query = false;
+static void SilentLog(SS4S_LogLevel level, const char *tag, const char *fmt, ...) {
+    (void) level; (void) tag; (void) fmt;
+}
+SS4S_LoggingFunction *SS4S_Log = SilentLog;
+static SS4S_AudioOpenResult FakeOpen(const SS4S_AudioInfo *info, SS4S_AudioInstance **instance,
+                                     SS4S_PlayerContext *context) {
+    (void) info; (void) context;
+    *instance = (SS4S_AudioInstance *) &close_calls;
+    return SS4S_AUDIO_OPEN_OK;
+}
+static void FakeClose(SS4S_AudioInstance *instance) {
+    assert(instance == (SS4S_AudioInstance *) &close_calls);
+    SDL_AtomicAdd(&close_calls, 1);
+}
+static bool FakeClock(SS4S_AudioInstance *instance, SS4S_AudioClock *clock, size_t size) {
+    assert(instance == (SS4S_AudioInstance *) &close_calls && size == sizeof(*clock));
+    if (block_query) {
+        SDL_SemPost(query_entered);
+        SDL_SemWait(query_release);
+        assert(SDL_AtomicGet(&close_calls) == 0);
+    }
+    clock->sample_rate = 48000;
+    return true;
+}
+static const SS4S_AudioDriver driver = {.Open = FakeOpen, .Close = FakeClose};
+const SS4S_AudioDriver *SS4S_GetAudioDriver(void) { return &driver; }
+SS4S_ModuleAudioGetClockV1Function *SS4S_GetAudioClockFunction(void) {
+    return supported ? FakeClock : NULL;
+}
+static bool pull_supported = false;
+static SS4S_AudioOpenResult FakePull(const SS4S_AudioInfo *info, SS4S_AudioInstance **instance,
+    SS4S_PlayerContext *context, SS4S_AudioPullRenderFunction render, void *render_context) {
+    (void)render; (void)render_context;
+    return FakeOpen(info, instance, context);
+}
+static unsigned FakeRender(void *context, int16_t *pcm, unsigned frames, uint64_t stamp) {
+    (void)context; (void)pcm; (void)stamp; return frames;
+}
+SS4S_ModuleAudioOpenPullV1Function *SS4S_GetAudioPullFunction(void) { return pull_supported ? FakePull : NULL; }
+static int QueryThread(void *p) {
+    SS4S_AudioClock clock;
+    assert(SS4S_PlayerAudioGetClock(p, &clock));
+    assert(clock.generation == 1);
+    return 0;
+}
+static int CloseThread(void *p) { assert(SS4S_PlayerAudioClose(p)); return 0; }
+int main(void) {
+    SS4S_Player player = {0};
+    player.mutex = SS4S_MutexCreate();
+    query_entered = SDL_CreateSemaphore(0);
+    query_release = SDL_CreateSemaphore(0);
+    SS4S_AudioClock clock;
+    memset(&clock, 0xff, sizeof(clock));
+    assert(!SS4S_PlayerAudioGetClock(&player, &clock));
+    assert(clock.generation == 0 && clock.sample_rate == 0);
+    assert(SS4S_PlayerAudioOpen(&player, NULL) == SS4S_AUDIO_OPEN_OK);
+    supported = false;
+    assert(!SS4S_PlayerAudioGetClock(&player, &clock));
+    assert(clock.generation == 0);
+    supported = true; block_query = true;
+    SDL_Thread *query = SDL_CreateThread(QueryThread, "query", &player);
+    assert(query);
+    SDL_SemWait(query_entered);
+    SDL_Thread *close = SDL_CreateThread(CloseThread, "close", &player);
+    assert(close);
+    SDL_Delay(20);
+    assert(SDL_AtomicGet(&close_calls) == 0);
+    SDL_SemPost(query_release);
+    SDL_WaitThread(query, NULL); SDL_WaitThread(close, NULL);
+    assert(SDL_AtomicGet(&close_calls) == 1);
+    assert(!SS4S_PlayerAudioGetClock(&player, &clock));
+    block_query = false;
+    assert(SS4S_PlayerAudioOpen(&player, NULL) == SS4S_AUDIO_OPEN_OK);
+    assert(SS4S_PlayerAudioGetClock(&player, &clock) && clock.generation == 2);
+    assert(SS4S_PlayerAudioClose(&player));
+    SS4S_AudioInfo info = {.codec=SS4S_AUDIO_PCM_S16LE,.sampleRate=48000,.numOfChannels=2,.samplesPerFrame=240};
+    assert(!SS4S_AudioHasPull());
+    assert(SS4S_PlayerAudioOpenPull(&player,&info,FakeRender,NULL)==SS4S_AUDIO_OPEN_ERROR);
+    assert(player.audio==NULL && player.audio_generation==2);
+    pull_supported=true;
+    assert(SS4S_AudioHasPull());
+    assert(SS4S_PlayerAudioOpenPull(&player,&info,NULL,NULL)==SS4S_AUDIO_OPEN_ERROR);
+    assert(SS4S_PlayerAudioOpenPull(&player,&info,FakeRender,NULL)==SS4S_AUDIO_OPEN_OK);
+    assert(player.audio_generation==3 && player.audio_pull);
+    assert(SS4S_PlayerAudioOpenPull(&player,&info,FakeRender,NULL)==SS4S_AUDIO_OPEN_ERROR);
+    assert(SS4S_PlayerAudioOpen(&player,&info)==SS4S_AUDIO_OPEN_ERROR);
+    assert(player.audio_generation==3);
+    assert(SS4S_PlayerAudioFeed(&player,NULL,0)==SS4S_AUDIO_FEED_ERROR);
+    assert(SS4S_PlayerAudioClose(&player) && !player.audio_pull);
+    assert(!SS4S_PlayerAudioClose(&player));
+    SDL_DestroySemaphore(query_entered); SDL_DestroySemaphore(query_release);
+    SS4S_MutexDestroy(player.mutex);
+    puts("PASS core: unsupported/closed zero snapshot, reopen generation, concurrent query serialized against close");
+    return 0;
+}
