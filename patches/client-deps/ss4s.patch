+#include <assert.h>
+#include <stdio.h>
+#include "module.h"
+#include "lib_logging.h"
+static void SilentLog(SS4S_LogLevel level, const char *tag, const char *fmt, ...) {
+    (void) level; (void) tag; (void) fmt;
+}
+SS4S_LoggingFunction *SS4S_Log = SilentLog;
+int main(void) {
+    SS4S_Module module;
+    SS4S_LibraryContext context = {.Log = SilentLog};
+    SS4S_ModuleAudioGetClockV1Function *clock_fn = NULL;
+    SS4S_ModuleAudioOpenPullV1Function *pull_fn = NULL;
+    assert(SS4S_ModuleOpen("legacy-fixture", &module, &context, &clock_fn, &pull_fn));
+    assert(clock_fn == NULL && pull_fn == NULL);
+    assert(SS4S_ModuleOpen("clock-fixture", &module, &context, &clock_fn, &pull_fn));
+    assert(clock_fn != NULL && pull_fn != NULL);
+    SS4S_AudioClock clock;
+    assert(clock_fn(NULL, &clock, sizeof(clock)) && clock.sample_rate == 48000);
+    assert(!clock_fn(NULL, &clock, sizeof(clock) + 1));
+    assert(SS4S_ModuleOpen("legacy-fixture", &module, &context, &clock_fn, &pull_fn));
+    assert(clock_fn == NULL && pull_fn == NULL); /* Cannot retain previous module's optional export. */
+    puts("PASS loader: old module without extension, versioned export, exact-size check, no cross-module clock reuse");
+    return 0;
+}
