+/* Actual SS4S Open/Close with SDL device calls mocked; no device is opened. */
+#include <assert.h>
+#include <stdio.h>
+#include <stdbool.h>
+#include <SDL2/SDL.h>
+static unsigned opens, closes, pauses, waits;
+static bool retry_first;
+static SDL_AudioDeviceID FakeOpen(const char *name, int capture, const SDL_AudioSpec *want,
+                                  SDL_AudioSpec *have, int changes) {
+    assert(name && !capture);
+    assert(changes == SDL_AUDIO_ALLOW_SAMPLES_CHANGE);
+    assert(want->freq == 48000 && want->channels == 2 && want->format == AUDIO_S16LSB);
+    assert(want->samples == 240 && want->callback);
+    ++opens;
+    if (retry_first && opens == 1) return 0;
+    *have = *want;
+    have->samples = 480; /* Mock negotiated physical demand period. */
+    return 17;
+}
+static void FakeClose(SDL_AudioDeviceID device) { assert(device == 17); ++closes; }
+static void FakePause(SDL_AudioDeviceID device, int pause) { assert(device == 17 && pause == 0); ++pauses; }
+static void FakeDelay(Uint32 ms) { assert(ms == 250); ++waits; }
+static int FakeCount(int capture) { assert(!capture); return 1; }
+static const char *FakeName(int index, int capture) { assert(index == 0 && !capture); return "Test endpoint (new)"; }
+#define SDL_OpenAudioDevice FakeOpen
+#define SDL_CloseAudioDevice FakeClose
+#define SDL_PauseAudioDevice FakePause
+#define SDL_Delay FakeDelay
+#define SDL_GetNumAudioDevices FakeCount
+#define SDL_GetAudioDeviceName FakeName
+#include "../modules/sdl/sdl.c"
+static void FakeLog(SS4S_LogLevel level, const char *tag, const char *fmt, ...) {
+    (void)level; (void)tag; (void)fmt;
+}
+int main(void) {
+    const SS4S_LibraryContext context = {.Log=FakeLog, .Audio={.device="Test endpoint (old)"}};
+    LibContext=&context;
+    const SS4S_AudioInfo info={.codec=SS4S_AUDIO_PCM_S16LE,.sampleRate=48000,.numOfChannels=2,.samplesPerFrame=240};
+    for (unsigned scenario=0; scenario<2; ++scenario) {
+        opens=closes=pauses=waits=0; retry_first=scenario != 0;
+        SS4S_AudioInstance *instance=NULL;
+        assert(Open(&info,&instance,NULL)==SS4S_AUDIO_OPEN_OK);
+        assert(opens==1+scenario && pauses==1 && waits==scenario && closes==0);
+        SS4S_AudioClock clock = {0};
+        assert(SS4S_ModuleAudioGetClockV1_SDL(instance,&clock,sizeof(clock)));
+        assert(clock.sample_rate==48000 && clock.quantum_frames==480 && clock.demand_frames==0);
+        unsigned char pcm[1920], output[1920];
+        memset(pcm,0x35,sizeof(pcm));
+        assert(Feed(instance,pcm,sizeof(pcm))==SS4S_AUDIO_FEED_OK);
+        Callback(instance,output,sizeof(output));
+        assert(!memcmp(pcm,output,sizeof(pcm)));
+        assert(SS4S_ModuleAudioGetClockV1_SDL(instance,&clock,sizeof(clock)));
+        assert(clock.quantum_frames==480 && clock.demand_frames==480 && clock.consumed_frames==480);
+        assert(clock.queued_frames==0 && clock.discarded_frames==0);
+        Close(instance); assert(closes==1);
+    }
+    puts("PASS SDL open: negotiated demand480, sample-only change initial/retry, exact PCM conservation");
+    return 0;
+}
diff --git a/tests/test_audio_clock_sdl.c b/tests/test_audio_clock_sdl.c
new file mode 100644
index 0000000000000000000000000000000000000000..57847ac2b51081f75581bb61b5ab6ff390a44184
--- /dev/null
+++ b/tests/test_audio_clock_sdl.c
@@ -0,0 +1,56 @@
+/* No device is opened: exercise the real SDL ring/feed/callback implementation. */
+#include <assert.h>
+#include <stdio.h>
+#include "../modules/sdl/sdl.c"
+
+int main(void) {
+    SS4S_AudioInstance instance = {0};
+    instance.ringbuf_capacity = 64;
+    instance.ringbuf = ringbuf_new(instance.ringbuf_capacity);
+    instance.ringbuf_mutex = SDL_CreateMutex();
+    instance.frame_bytes = 4;
+    instance.sample_rate = 48000;
+    instance.callback_frames = 240;
+    instance.counter_frequency = SDL_GetPerformanceFrequency();
+    assert(instance.ringbuf && instance.ringbuf_mutex && instance.counter_frequency);
+    unsigned char input[64], output[64];
+    for (unsigned i = 0; i < sizeof(input); ++i) input[i] = (unsigned char) (i + 1);
+    SS4S_AudioClock clock;
+    memset(&clock, 0x5a, sizeof(clock));
+    assert(!SS4S_ModuleAudioGetClockV1_SDL(&instance, &clock, sizeof(clock) - 1));
+    assert(((unsigned char *) &clock)[0] == 0x5a); /* Reject before writing. */
+    assert(Feed(&instance, input, 48) == SS4S_AUDIO_FEED_OK);
+    assert(Feed(&instance, input, 32) == SS4S_AUDIO_FEED_OVERFLOW);
+    assert(Feed(&instance, input, 64) == SS4S_AUDIO_FEED_OVERFLOW);
+    assert(Feed(&instance, input, 3) == SS4S_AUDIO_FEED_ERROR);
+    assert(Feed(&instance, NULL, 4) == SS4S_AUDIO_FEED_ERROR);
+    assert(SS4S_ModuleAudioGetClockV1_SDL(&instance, &clock, sizeof(clock)));
+    assert(clock.queued_frames == 12 && clock.demand_frames == 0);
+    assert(instance.submitted_bytes == 48 && instance.cleared_bytes == 0);
+    Callback(&instance, output, 20);
+    assert(memcmp(input, output, 20) == 0);
+    assert(SS4S_ModuleAudioGetClockV1_SDL(&instance, &clock, sizeof(clock)));
+    assert(clock.quantum_frames == 5 && clock.demand_frames == 5);
+    assert(clock.consumed_frames == 5 && clock.queued_frames == 7);
+    const uint64_t stamp = clock.observed_us;
+    assert(Feed(&instance, input, 16) == SS4S_AUDIO_FEED_OK); /* Wraps ring. */
+    assert(SS4S_ModuleAudioGetClockV1_SDL(&instance, &clock, sizeof(clock)));
+    assert(clock.observed_us == stamp && clock.queued_frames == 11);
+    Callback(&instance, output, 64); /* Larger than requested; partial underrun. */
+    assert(memcmp(output, input + 20, 28) == 0);
+    assert(memcmp(output + 28, input, 16) == 0);
+    for (unsigned i = 44; i < sizeof(output); ++i) assert(output[i] == 0);
+    assert(SS4S_ModuleAudioGetClockV1_SDL(&instance, &clock, sizeof(clock)));
+    assert(clock.quantum_frames == 16 && clock.demand_frames == 21);
+    assert(clock.consumed_frames == 16 && clock.queued_frames == 0);
+    assert(clock.discarded_frames == 0 && clock.observed_us >= stamp);
+    assert(instance.submitted_bytes / 4 == clock.consumed_frames + clock.queued_frames);
+    Callback(&instance, output, 12); /* Fully starved device still advances. */
+    assert(SS4S_ModuleAudioGetClockV1_SDL(&instance, &clock, sizeof(clock)));
+    assert(clock.demand_frames == 24 && clock.consumed_frames == 16);
+    assert(instance.silence_bytes == 32);
+    ringbuf_delete(instance.ringbuf);
+    SDL_DestroyMutex(instance.ringbuf_mutex);
+    puts("PASS SDL: actual callback quantum, demand including silence, accepted conservation, wrap/order, non-destructive overflow, ABI-size rejection");
+    return 0;
+}
diff --git a/tests/test_audio_pull_pulse.c b/tests/test_audio_pull_pulse.c
new file mode 100644
index 0000000000000000000000000000000000000000..53e35a6b16d0a9c5225bd25f371c72ed48e03c65
--- /dev/null
+++ b/tests/test_audio_pull_pulse.c
@@ -0,0 +1,93 @@
+/* PulseAudio pull mode against a REAL server (skips with exit 77 when none answers).
+ * Renders silence only, so it is inaudible on whatever sink is the default. Checks the
+ * device-paced contract: open works, Feed is refused, render is never re-entered, its
+ * timestamps never go backwards, delivery tracks real time, and Close joins the
+ * mainloop before reporting the final ledger. */
+#include <assert.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <unistd.h>
+#include <stdatomic.h>
+#include <pthread.h>
+#include "../modules/pulse/pulse.c"
+
+static atomic_int in_render, closed, have_render_thread;
+static pthread_t render_thread;
+static atomic_ullong rendered_frames, render_calls;
+static uint64_t last_begin;
+static int ledger_seen, open_seen;
+static const int token = 52817;
+
+static void CaptureLog(SS4S_LogLevel level, const char *tag, const char *fmt, ...) {
+    (void) level; (void) tag;
+    /* Logging must never happen ON the backend thread that renders. */
+    if (atomic_load(&have_render_thread)) assert(!pthread_equal(pthread_self(), render_thread));
+    char line[1024];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(line, sizeof(line), fmt, ap);
+    va_end(ap);
+    if (strstr(line, "[AUDIO-OUTPUT] backend=pulse phase=opened")) open_seen = 1;
+    if (strstr(line, "[AUDIO-OUTPUT] backend=pulse phase=final")) {
+        assert(atomic_load(&closed));   /* reported only after the mainloop is joined */
+        ledger_seen = 1;
+    }
+    printf("log: %s\n", line);
+}
+
+static unsigned Render(void *context, int16_t *pcm, unsigned frames, uint64_t begin_us) {
+    assert(context == &token && pcm != NULL && frames > 0 && begin_us > 0);
+    assert(!atomic_exchange(&in_render, 1));
+    if (!atomic_load(&have_render_thread)) {
+        render_thread = pthread_self();
+        atomic_store(&have_render_thread, 1);
+    }
+    assert(begin_us >= last_begin);
+    last_begin = begin_us;
+    memset(pcm, 0, (size_t) frames * 4u);
+    atomic_fetch_add(&rendered_frames, frames);
+    atomic_fetch_add(&render_calls, 1);
+    atomic_store(&in_render, 0);
+    return frames;
+}
+
+int main(void) {
+    setvbuf(stdout, NULL, _IONBF, 0);   /* an assert must not swallow the measurements */
+    const SS4S_LibraryContext context = {.Log = CaptureLog};
+    SS4S_Module module = {0};
+    assert(SS4S_ModuleOpen_PULSE(&module, &context));
+    const SS4S_AudioInfo info = {.codec = SS4S_AUDIO_PCM_S16LE, .numOfChannels = 2, .sampleRate = 48000,
+            .samplesPerFrame = 240, .appName = "Eclipse test", .streamName = "pull test (silence)"};
+    SS4S_AudioInstance *instance = NULL;
+    const uint64_t start = ClientTimeUs();
+    const SS4S_AudioOpenResult rc = SS4S_ModuleAudioOpenPullV1_PULSE(&info, &instance, NULL, Render, (void *) &token);
+    if (rc != SS4S_AUDIO_OPEN_OK) {
+        printf("SKIP: no PulseAudio server answered (open rc=%d)\n", rc);
+        return 77;
+    }
+    assert(open_seen);
+    const unsigned char dummy[960] = {0};
+    assert(module.AudioDriver->Feed(instance, dummy, sizeof(dummy)) == SS4S_AUDIO_FEED_ERROR);
+    while (atomic_load(&render_calls) == 0 && ClientTimeUs() - start < 3000000u) usleep(1000);
+    const double startup_ms = (double) (ClientTimeUs() - start) / 1e3;
+    sleep(1);
+    const uint64_t frames_a = atomic_load(&rendered_frames), t_a = ClientTimeUs();
+    sleep(2);
+    const uint64_t frames_b = atomic_load(&rendered_frames), t_b = ClientTimeUs();
+    const double elapsed = (double) (t_b - t_a) / 1e6;
+    const PullStats snapshot = instance->pull;   /* racy copy for printing only */
+    atomic_store(&closed, 1);
+    module.AudioDriver->Close(instance);
+    assert(ledger_seen);
+    const unsigned calls_after_close = (unsigned) atomic_load(&render_calls);
+    usleep(100 * 1000);
+    assert(atomic_load(&render_calls) == calls_after_close);   /* nothing runs after Close */
+    const double delivered_s = (double) (frames_b - frames_a) / 48000.0;
+    printf("first render after %.1f ms; steady window %.3f s wall, %.3f s delivered (%+.1f ms), %llu callbacks, "
+           "underflows so far %llu\n", startup_ms, elapsed, delivered_s, (delivered_s - elapsed) * 1000.0,
+           (unsigned long long) snapshot.callbacks, (unsigned long long) snapshot.underflows);
+    /* Device-paced: the steady 2 s window must track real time within +-30 ms. */
+    assert(delivered_s > elapsed - 0.03 && delivered_s < elapsed + 0.03);
+    puts("PulseAudio pull PASS (real server, silence)");
+    return 0;
+}
diff --git a/tests/test_audio_pull_sdl.c b/tests/test_audio_pull_sdl.c
