+/* Disconnect under the lock, then stop: stop joins the mainloop thread, so no
+ * callback can run once it returns. */
+static void PullTeardown(SS4S_AudioInstance *instance) {
+    if (instance->loop == NULL) return;
+    if (instance->loop_started) pa_threaded_mainloop_lock(instance->loop);
+    instance->closing = 1;
+    if (instance->stream != NULL) {
+        pa_stream_set_write_callback(instance->stream, NULL, NULL);
+        pa_stream_disconnect(instance->stream);
