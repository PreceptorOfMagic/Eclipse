--- /dev/null
+++ b/modules/android/CMakeLists.txt
@@ -0,0 +1,12 @@
+# Android video backend: MediaCodec rendering into a video surface under the app's UI (see mediacodec.c).
+if (NOT ANDROID)
+    return()
+endif ()
+find_package(PkgConfig REQUIRED)
+pkg_check_modules(SDL2 REQUIRED sdl2)
+ss4s_add_module(mediacodec FOR_VIDEO DISPLAY_NAME "MediaCodec" SOURCES mediacodec.c WEIGHT 50)
+if (NOT SS4S_MODULE_TARGET)
+    return()
+endif ()
+target_include_directories(${SS4S_MODULE_TARGET} SYSTEM PRIVATE ${SDL2_INCLUDE_DIRS})
+target_link_libraries(${SS4S_MODULE_TARGET} PRIVATE ${SDL2_LIBRARIES} mediandk android log)
diff --git a/modules/android/mediacodec.c b/modules/android/mediacodec.c
new file mode 100644
index 0000000000000000000000000000000000000000..3ebcf36001cdfaa850f2397a1b0975b4190b8625
--- /dev/null
+++ b/modules/android/mediacodec.c
@@ -0,0 +1,891 @@
+/*
+ * SS4S video module: Android MediaCodec, for Android TV devices (the NVIDIA Shield first).
+ *
+ * THE PRESENTATION MODEL IS webOS'S, NOT THE DESKTOP'S. The decoder renders straight into a SurfaceView of its
+ * own that sits UNDER the app's translucent SDL surface (deploy/android, EclipseActivity): a hardware overlay
+ * plane, exactly as starfish/NDL put the TV's video on a plane under the UI. So this reports
+ * SS4S_VIDEO_CAP_TRANSFORM_UI_COMPOSITING like the NDL modules, the app clears its UI to transparent while a
+ * stream runs, and nothing here touches SDL's renderer. Decoded pictures never come back to the CPU.
+ *
+ * WHAT IS COPIED RATHER THAN INVENTED. The decoder choice and its low-latency configuration follow Moonlight
+ * for Android (moonlight-stream/moonlight-android, MediaCodecHelper.java and MediaCodecDecoderRenderer.java),
+ * the client that has run on the Shield since GameStream was a Shield feature: prefer a hardware decoder,
+ * request real-time priority and the platform's low-latency mode, set the vendors' own low-latency keys, send
+ * parameter sets as codec-config buffers, and render every decoded picture the moment it is ready.
+ *
+ * Java does the parts the NDK cannot: listing decoders (MediaCodecList) and owning the video surface. It is
+ * reached through SDL's JNI environment. The co-op peer process has no Java VM at all, so the decoder list the
+ * primary probes is passed down in the environment (MEDIACODEC_PROBE_ENV) and the peer never calls Java.
+ */
+#include "ss4s/modapi.h"
+
+#include <SDL.h>
+#include <SDL_system.h>
+#include <jni.h>
+#include <android/log.h>
+#include <android/native_window.h>
+#include <android/native_window_jni.h>
+#include <media/NdkMediaCodec.h>
+#include <media/NdkMediaFormat.h>
+
+#include <errno.h>
+#include <pthread.h>
+#include <stdarg.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <time.h>
+
+#define LOG_TAG "MediaCodec"
+#define MEDIACODEC_PROBE_ENV "ECLIPSE_MEDIACODEC_PROBE"
+/* Set by the app in the co-op peer process (platform/android/android_platform.c). */
+#define PEER_PROCESS_ENV "ECLIPSE_ANDROID_PEER"
+
+/* Input: how long one Feed() waits for a free input buffer before the picture is given up and a keyframe
+ * requested -- long enough for a decoder that is merely busy, short enough not to stall the network thread. */
+#define INPUT_WAIT_US 10000
+#define INPUT_WAIT_TRIES 50
+/* Output: the render thread wakes this often even without pictures, so Close() never waits long. */
+#define OUTPUT_WAIT_US 20000
+/* Surface: the activity creates it with the window; a stream can start before Android has made it. */
+#define SURFACE_WAIT_MS 3000
+/* A restart of the decoder that fails is retried at the next keyframes for this long before the stream is ended as
+ * a decoder error: Android abandons the video surface when the screen turns off (the TV switched input, the device
+ * slept), before the activity reports going to the background, and every start on the dead surface fails. */
+#ifndef RESTART_GRACE_US
+#define RESTART_GRACE_US 3000000u
+#endif
+
+static const SS4S_LibraryContext *LibContext = NULL;
+
+/* --- the decoder list ------------------------------------------------------------------------------------ */
+
+typedef struct DecoderEntry {
+    SS4S_VideoCodec codec;
+    char name[128];
+    bool hardware;
+    bool low_latency;
+    bool main10;
+    int max_width, max_height;
+} DecoderEntry;
+
+static DecoderEntry Decoders[8];
+static int DecoderCount = 0;
+static bool DisplayHdr10 = false;
+static bool Probed = false;
+static pthread_mutex_t ProbeLock = PTHREAD_MUTEX_INITIALIZER;
+
+struct SS4S_PlayerContext {
+    SS4S_Player *player;
+};
+
+typedef struct ParamSets {
+    unsigned char data[4096];
+    size_t len;
+} ParamSets;
+
+struct SS4S_VideoInstance {
+    SS4S_PlayerContext *context;
+    SS4S_VideoCodec codec;
+    const char *mime;
+    int width, height, fps;
+    const DecoderEntry *decoder;
+
+    pthread_mutex_t lock;          /* codec lifetime vs Feed()/render thread */
+    AMediaCodec *mc;
+    ANativeWindow *window;
+    pthread_t render_thread;
+    bool render_running;
+    atomic_bool stop;
+
+    bool have_hdr;
+    SS4S_VideoHDRInfo hdr;
+    bool reconfigure_at_keyframe;  /* HDR changed: take effect at the next IDR, as the TV reloads its pipeline */
+    bool need_keyframe;            /* a picture was lost: everything until the next IDR would be garbage */
+    uint64_t restart_failing_since; /* a restart failed (MonotonicUs), 0 when the decoder is running */
+
+    ParamSets params;              /* the last parameter sets sent as codec config */
+    unsigned long fed, rendered, dropped_output, lost_input, errors;
+};
+
+static void LogMsg(SS4S_LogLevel level, const char *fmt, ...) __attribute__((format(printf, 2, 3)));
+
+static void LogMsg(SS4S_LogLevel level, const char *fmt, ...) {
+    char buf[512];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(buf, sizeof(buf), fmt, ap);
+    va_end(ap);
+    if (LibContext != NULL && LibContext->Log != NULL) {
+        LibContext->Log(level, LOG_TAG, "%s", buf);
+    } else {
+        __android_log_print(level >= SS4S_LogLevelError ? ANDROID_LOG_ERROR : ANDROID_LOG_INFO, LOG_TAG, "%s", buf);
+    }
+}
+
+static uint64_t MonotonicUs(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t) ts.tv_sec * 1000000u + (uint64_t) ts.tv_nsec / 1000u;
+}
+
+static const char *MimeOf(SS4S_VideoCodec codec) {
+    switch (codec) {
+        case SS4S_VIDEO_H264:
+            return "video/avc";
+        case SS4S_VIDEO_H265:
+            return "video/hevc";
+        case SS4S_VIDEO_AV1:
+            return "video/av01";
+        case SS4S_VIDEO_VP9:
+            return "video/x-vnd.on2.vp9";
+        default:
+            return NULL;
+    }
+}
+
+static SS4S_VideoCodec CodecOfMime(const char *mime) {
+    if (strcmp(mime, "video/avc") == 0) return SS4S_VIDEO_H264;
+    if (strcmp(mime, "video/hevc") == 0) return SS4S_VIDEO_H265;
+    if (strcmp(mime, "video/av01") == 0) return SS4S_VIDEO_AV1;
+    if (strcmp(mime, "video/x-vnd.on2.vp9") == 0) return SS4S_VIDEO_VP9;
+    return SS4S_VIDEO_NONE;
+}
+
+/* --- Java --------------------------------------------------------------------------------------------------
+ * EclipseActivity's static helpers, found through the live activity object: on a thread SDL attached to the
+ * VM, FindClass would use the system class loader, which cannot see the app's classes. */
+
+static JNIEnv *ActivityEnv(jclass *cls_out) {
+    if (getenv(PEER_PROCESS_ENV) != NULL) {
+        return NULL;   /* the co-op peer: no Java VM in this process */
+    }
+    JNIEnv *env = (JNIEnv *) SDL_AndroidGetJNIEnv();
+    if (env == NULL) {
+        return NULL;
+    }
+    jobject activity = (jobject) SDL_AndroidGetActivity();
+    if (activity == NULL) {
+        return NULL;
+    }
+    *cls_out = (*env)->GetObjectClass(env, activity);
+    (*env)->DeleteLocalRef(env, activity);
+    return *cls_out != NULL ? env : NULL;
+}
+
+static bool ClearException(JNIEnv *env, const char *what) {
+    if ((*env)->ExceptionCheck(env)) {
+        (*env)->ExceptionDescribe(env);
+        (*env)->ExceptionClear(env);
+        LogMsg(SS4S_LogLevelWarn, "%s threw a Java exception", what);
+        return true;
+    }
+    return false;
+}
+
+/* EclipseActivity.probeVideoDecoders(): one line per usable decoder, best first for each MIME type,
+ *     mime|name|hardware|lowLatency|main10|maxWidth|maxHeight
+ * and a first line "display|hdr10" (0/1). */
+static char *JavaProbe(void) {
+    jclass cls = NULL;
+    JNIEnv *env = ActivityEnv(&cls);
+    if (env == NULL) {
+        return NULL;
+    }
+    char *copy = NULL;
+    jmethodID method = (*env)->GetStaticMethodID(env, cls, "probeVideoDecoders", "()Ljava/lang/String;");
+    if (method != NULL) {
+        jstring result = (jstring) (*env)->CallStaticObjectMethod(env, cls, method);
+        if (!ClearException(env, "probeVideoDecoders") && result != NULL) {
+            const char *chars = (*env)->GetStringUTFChars(env, result, NULL);
+            if (chars != NULL) {
+                copy = strdup(chars);
+                (*env)->ReleaseStringUTFChars(env, result, chars);
+            }
+        }
+        if (result != NULL) {
+            (*env)->DeleteLocalRef(env, result);
+        }
+    } else {
+        ClearException(env, "probeVideoDecoders lookup");
+    }
+    (*env)->DeleteLocalRef(env, cls);
+    return copy;
+}
+
+static void ParseProbe(const char *text) {
+    DecoderCount = 0;
+    DisplayHdr10 = false;
+    char *copy = strdup(text), *save = NULL;
+    if (copy == NULL) {
+        return;
+    }
+    for (char *line = strtok_r(copy, "\n", &save); line != NULL; line = strtok_r(NULL, "\n", &save)) {
+        char *fields[8] = {0};
+        int n = 0;
+        char *fsave = NULL;
+        for (char *f = strtok_r(line, "|", &fsave); f != NULL && n < 8; f = strtok_r(NULL, "|", &fsave)) {
+            fields[n++] = f;
+        }
+        if (n == 2 && strcmp(fields[0], "display") == 0) {
+            DisplayHdr10 = atoi(fields[1]) != 0;
+            continue;
+        }
+        if (n != 7 || DecoderCount >= (int) (sizeof(Decoders) / sizeof(Decoders[0]))) {
+            continue;
+        }
+        const SS4S_VideoCodec codec = CodecOfMime(fields[0]);
+        if (codec == SS4S_VIDEO_NONE) {
+            continue;
+        }
+        DecoderEntry *e = &Decoders[DecoderCount++];
+        memset(e, 0, sizeof(*e));
+        e->codec = codec;
+        snprintf(e->name, sizeof(e->name), "%s", fields[1]);
+        e->hardware = atoi(fields[2]) != 0;
+        e->low_latency = atoi(fields[3]) != 0;
+        e->main10 = atoi(fields[4]) != 0;
+        e->max_width = atoi(fields[5]);
+        e->max_height = atoi(fields[6]);
+    }
+    free(copy);
+}
+
+static void EnsureProbed(void) {
+    pthread_mutex_lock(&ProbeLock);
+    if (!Probed) {
+        const char *inherited = getenv(MEDIACODEC_PROBE_ENV);
+        char *probe = inherited != NULL ? strdup(inherited) : JavaProbe();
+        if (probe != NULL) {
+            ParseProbe(probe);
+            Probed = true;
+            /* The co-op peer is exec'd later and inherits the environment: its own capability questions
+             * (codec negotiation with its host) get the same answer without a Java VM. */
+            if (inherited == NULL) {
+                setenv(MEDIACODEC_PROBE_ENV, probe, 1);
+            }
+            for (int i = 0; i < DecoderCount; ++i) {
+                LogMsg(SS4S_LogLevelInfo, "Decoder %s: %s%s%s%s, up to %dx%d", SS4S_VideoCodecName(Decoders[i].codec),
+                       Decoders[i].name, Decoders[i].hardware ? " (hardware)" : " (SOFTWARE)",
+                       Decoders[i].low_latency ? ", low-latency mode" : "",
+                       Decoders[i].main10 ? ", 10-bit" : "", Decoders[i].max_width, Decoders[i].max_height);
+            }
+            LogMsg(SS4S_LogLevelInfo, "Display HDR10: %s", DisplayHdr10 ? "yes" : "no");
+            free(probe);
+        }
+    }
+    pthread_mutex_unlock(&ProbeLock);
+}
+
+static const DecoderEntry *DecoderFor(SS4S_VideoCodec codec) {
+    for (int i = 0; i < DecoderCount; ++i) {
+        if (Decoders[i].codec == codec) {
+            return &Decoders[i];
+        }
+    }
+    return NULL;
+}
+
+/* The activity's video surface as it is now, or NULL; *no_vm (optional) is set when there is no Java VM to ask. */
+static ANativeWindow *CurrentWindow(int width, int height, bool *no_vm) {
+    ANativeWindow *window = NULL;
+    jclass cls = NULL;
+    JNIEnv *env = ActivityEnv(&cls);
+    if (no_vm != NULL) {
+        *no_vm = env == NULL;
+    }
+    if (env == NULL) {
+        return NULL;
+    }
+    jmethodID size = (*env)->GetStaticMethodID(env, cls, "setVideoSize", "(II)V");
+    if (size != NULL) {
+        /* Letterbox a stream whose shape is not the screen's, as the TV's video plane does. */
+        (*env)->CallStaticVoidMethod(env, cls, size, (jint) width, (jint) height);
+    }
+    ClearException(env, "setVideoSize");
+    jmethodID get = (*env)->GetStaticMethodID(env, cls, "getVideoSurface", "()Landroid/view/Surface;");
+    if (get != NULL) {
+        jobject surface = (*env)->CallStaticObjectMethod(env, cls, get);
+        if (!ClearException(env, "getVideoSurface") && surface != NULL) {
+            window = ANativeWindow_fromSurface(env, surface);
+            (*env)->DeleteLocalRef(env, surface);
+        }
+    } else {
+        ClearException(env, "getVideoSurface lookup");
+    }
+    (*env)->DeleteLocalRef(env, cls);
+    return window;
+}
+
+/* The video surface, waiting for Android to create it if a stream starts first. */
+static ANativeWindow *AcquireWindow(int width, int height) {
+    const uint64_t deadline = MonotonicUs() + (uint64_t) SURFACE_WAIT_MS * 1000u;
+    do {
+        bool no_vm = false;
+        ANativeWindow *window = CurrentWindow(width, height, &no_vm);
+        if (window != NULL || no_vm) {
+            return window;
+        }
+        SDL_Delay(20);
+    } while (MonotonicUs() < deadline);
+    return NULL;
+}
