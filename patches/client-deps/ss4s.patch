+++ b/tests/test_audio_pull_sdl.c
@@ -0,0 +1,108 @@
+/* Actual pull callback and SDL dummy-device lifecycle; never opens a real sink. */
+#include <assert.h>
+#include <stdio.h>
+#include "../modules/sdl/sdl.c"
+static SDL_atomic_t calls, closed, in_render;
+static SDL_sem *entered, *release, *close_entered;
+static SS4S_AudioInstance *closing_instance;
+static SDL_atomic_t final_ledger_checked;
+static SDL_atomic_t block_render;
+static unsigned mode;
+static const int token=41731;
+static void SilentLog(SS4S_LogLevel level,const char *tag,const char *fmt,...) {
+    (void)level;(void)tag;(void)fmt;
+    assert(!SDL_AtomicGet(&in_render));
+    if(closing_instance && strstr(fmt,"[AUDIO-OUTPUT]")) {
+        const SS4S_AudioInstance *i=closing_instance; /* Close has joined callback. */
+        assert(i->pull_stats.publish_skips>0);
+        assert(i->callbacks==i->pull_stats.callbacks);
+        assert(i->pull_publish_skips==i->pull_stats.publish_skips);
+        assert(i->pull_frames==i->pull_stats.delivered_frames);
+        assert(i->submitted_bytes==i->consumed_bytes);
+        assert(i->consumed_bytes==i->pull_stats.delivered_frames*4);
+        assert(i->silence_bytes==(i->pull_stats.demand_frames-i->pull_stats.delivered_frames)*4);
+        SDL_AtomicSet(&final_ledger_checked,1);
+    }
+}
+static unsigned Render(void *context,int16_t *pcm,unsigned frames,uint64_t begin) {
+    assert(context==&token && begin>0 && frames>0);
+    SDL_AtomicSet(&in_render,1);
+    SDL_AtomicAdd(&calls,1);
+    for(unsigned i=0;i<frames*2;++i) pcm[i]=(int16_t)(i+1);
+    if(SDL_AtomicCAS(&block_render,1,0)) { SDL_SemPost(entered); SDL_SemWait(release); } /* Fixture only: test in-flight join. */
+    SDL_AtomicSet(&in_render,0);
+    return mode==1 ? frames/2 : mode==2 ? frames+1 : frames;
+}
+static SDL_sem *stats_held, *stats_release;
+static SDL_atomic_t stats_timed_out;
+static int HoldStats(void *value) {
+    SS4S_AudioInstance *instance=value;
+    SDL_LockMutex(instance->ringbuf_mutex);SDL_SemPost(stats_held);
+    if (SDL_SemWaitTimeout(stats_release,2000)!=0) SDL_AtomicSet(&stats_timed_out,1);
+    SDL_UnlockMutex(instance->ringbuf_mutex);return 0;
+}
+static int CloseThread(void *instance) { SDL_SemPost(close_entered);Close(instance);SDL_AtomicSet(&closed,1);return 0; }
+int main(void) {
+    const SS4S_LibraryContext context={.Log=SilentLog};LibContext=&context;
+    SS4S_AudioInstance instance={0};
+    instance.frame_bytes=4;instance.sample_rate=48000;
+    instance.counter_frequency=SDL_GetPerformanceFrequency();
+    instance.ringbuf_mutex=SDL_CreateMutex();assert(instance.ringbuf_mutex);
+    instance.pull_render=Render;instance.pull_context=(void*)&token;
+    unsigned char output[960];
+    Callback(&instance,output,sizeof(output));
+    assert(((int16_t*)output)[0]==1 && instance.pull_frames==240);
+    assert(instance.submitted_bytes==960 && instance.consumed_bytes==960 && instance.silence_bytes==0);
+    mode=1;Callback(&instance,output,sizeof(output));
+    assert(((int16_t*)output)[0]==1);
+    for(unsigned i=480;i<sizeof(output);++i)assert(output[i]==0);
+    assert(instance.pull_frames==360 && instance.pull_short_frames==120);
+    mode=2;Callback(&instance,output,sizeof(output));
+    for(unsigned i=0;i<sizeof(output);++i)assert(output[i]==0);
+    assert(instance.pull_invalid_results==1 && instance.pull_short_frames==360);
+    assert(instance.submitted_bytes==1440 && instance.consumed_bytes==1440 && instance.silence_bytes==1440);
+    assert(Feed(&instance,output,sizeof(output))==SS4S_AUDIO_FEED_ERROR);
+    SS4S_AudioClock clock={0};
+    assert(SS4S_ModuleAudioGetClockV1_SDL(&instance,&clock,sizeof(clock)));
+    assert(clock.demand_frames==720 && clock.consumed_frames==360 && clock.queued_frames==0);
+    stats_held=SDL_CreateSemaphore(0);stats_release=SDL_CreateSemaphore(0);assert(stats_held&&stats_release);
+    SDL_Thread *holder=SDL_CreateThread(HoldStats,"hold-stats",&instance);assert(holder);
+    assert(SDL_SemWaitTimeout(stats_held,2000)==0);
+    mode=0;Callback(&instance,output,sizeof(output)); /* Must RETURN while reader still holds lock. */
+    assert(!SDL_AtomicGet(&stats_timed_out));
+    assert(instance.callbacks==3 && instance.pull_stats.callbacks==4 && instance.pull_stats.publish_skips==1);
+    SDL_SemPost(stats_release);SDL_WaitThread(holder,NULL);
+    Callback(&instance,output,sizeof(output));
+    assert(instance.callbacks==5 && instance.pull_frames==840 && instance.pull_publish_skips==1);
+    assert(instance.submitted_bytes==3360 && instance.consumed_bytes==3360 && instance.silence_bytes==1440);
+    SDL_DestroySemaphore(stats_held);SDL_DestroySemaphore(stats_release);
+    SDL_DestroyMutex(instance.ringbuf_mutex);
+
+    assert(SDL_setenv("SDL_AUDIODRIVER","dummy",1)==0);
+    assert(SDL_InitSubSystem(SDL_INIT_AUDIO)==0);
+    assert(strcmp(SDL_GetCurrentAudioDriver(),"dummy")==0);
+    entered=SDL_CreateSemaphore(0);release=SDL_CreateSemaphore(0);assert(entered&&release);
+    mode=0;SDL_AtomicSet(&block_render,1);
+    /* Dummy SDL requires a power-of-two request; direct callback ledger above remains 240. */
+    SS4S_AudioInfo info={.codec=SS4S_AUDIO_PCM_S16LE,.sampleRate=48000,.numOfChannels=2,.samplesPerFrame=256};
+    SS4S_AudioInstance *opened=NULL;
+    assert(SS4S_ModuleAudioOpenPullV1_SDL(&info,&opened,NULL,NULL,(void*)&token)==SS4S_AUDIO_OPEN_ERROR);
+    assert(opened==NULL);
+    assert(SS4S_ModuleAudioOpenPullV1_SDL(&info,&opened,NULL,Render,(void*)&token)==SS4S_AUDIO_OPEN_OK);
+    assert(SDL_SemWaitTimeout(entered,2000)==0); /* Immutable context valid on FIRST callback. */
+    closing_instance=opened;close_entered=SDL_CreateSemaphore(0);assert(close_entered);
+    SDL_LockMutex(opened->ringbuf_mutex); /* Force final callback publication to skip. */
+    SDL_Thread *closer=SDL_CreateThread(CloseThread,"close-pull",opened);assert(closer);
+    assert(SDL_SemWaitTimeout(close_entered,2000)==0);
+    SDL_Delay(20);assert(!SDL_AtomicGet(&closed));
+    SDL_SemPost(release);
+    SDL_Delay(20);assert(!SDL_AtomicGet(&closed)); /* Close awaits final snapshot lock. */
+    SDL_UnlockMutex(opened->ringbuf_mutex);
+    SDL_WaitThread(closer,NULL);assert(SDL_AtomicGet(&closed));
+    assert(SDL_AtomicGet(&final_ledger_checked));closing_instance=NULL;
+    SDL_DestroySemaphore(close_entered);
+    int after=SDL_AtomicGet(&calls);SDL_Delay(20);assert(SDL_AtomicGet(&calls)==after);
+    SDL_DestroySemaphore(entered);SDL_DestroySemaphore(release);SDL_QuitSubSystem(SDL_INIT_AUDIO);
+    puts("PASS pull: full/short/invalid exact ledger, nonblocking publication and exact final flush, push rejection, immutable first context, close joins callback, no callback after close");
+    return 0;
+}
