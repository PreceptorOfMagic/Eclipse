+    uint64_t consumed_frames; /* Real accepted PCM removed for output. */
+    uint64_t queued_frames; /* Accepted PCM still held by this backend. */
+    uint64_t discarded_frames; /* Accepted PCM removed without output. */
+    uint64_t observed_us;
+    uint64_t generation; /* Per-player successful-open epoch; compare only on the same player. */
