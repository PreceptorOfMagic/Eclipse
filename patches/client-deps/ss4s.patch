+/* Mainloop thread, loop lock held. Render into PulseAudio's own buffer: no copy, no
+ * waiting, and nothing here may log or call back into SS4S. */
+static void PullWrite(pa_stream *s, size_t nbytes, void *userdata) {
+    SS4S_AudioInstance *instance = userdata;
+    PullStats *p = &instance->pull;
+    const size_t frame_bytes = (size_t) instance->frame_bytes;
+    if (nbytes / frame_bytes > p->max_request_frames) p->max_request_frames = (unsigned) (nbytes / frame_bytes);
+    p->last_request_frames = (unsigned) (nbytes / frame_bytes);
+    while (nbytes >= frame_bytes) {
+        void *data = NULL;
+        size_t len = nbytes;
+        if (pa_stream_begin_write(s, &data, &len) < 0 || data == NULL) {
+            p->write_errors++;
+            return;
+        }
+        if (len > nbytes) len = nbytes;   /* never render more than was requested */
+        const unsigned frames = (unsigned) (len / frame_bytes);
+        if (frames == 0) {
+            pa_stream_cancel_write(s);
+            return;
+        }
+        len = (size_t) frames * frame_bytes;
+        const uint64_t begin_us = ClientTimeUs();
+        unsigned produced = instance->render(instance->render_context, data, frames, begin_us);
+        if (produced > frames) {
+            produced = 0;
+            p->invalid_results++;
+        }
+        memset((char *) data + (size_t) produced * frame_bytes, 0, len - (size_t) produced * frame_bytes);
+        const uint64_t render_us = ClientTimeUs() - begin_us;
+        if (pa_stream_write(s, data, len, NULL, 0, PA_SEEK_RELATIVE) < 0) {
+            p->write_errors++;
+            return;
+        }
+        p->demand_frames += frames;
+        p->delivered_frames += produced;
+        p->short_frames += frames - produced;
+        p->callbacks++;
+        if (render_us > p->render_max_us) p->render_max_us = render_us;
+        if (render_us > (uint64_t) frames * 1000000u / (unsigned) instance->sample_rate) p->deadline_misses++;
+        if (p->last_begin_us && begin_us - p->last_begin_us > p->interval_max_us)
+            p->interval_max_us = begin_us - p->last_begin_us;
+        p->last_begin_us = begin_us;
+        nbytes -= len;
+    }
